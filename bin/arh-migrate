#!/usr/bin/env bash
# Bring a study up to this framework: a 0.1 layout (state in .dl/) moves to .arh/, and the study's
# copies of the agent contract (AGENTS.md) and skills/ are refreshed. Dry run by default.
#
#   arh migrate [DIR]           list every change; nothing is written
#   arh migrate [DIR] --apply   write a backup, apply the changes, then run the checks
#
# This is the only command that knows the 0.1 names. Iteration and verification files are never
# touched, and re-running it on an up-to-date study changes nothing.
set -euo pipefail
# shellcheck source=lib/common.sh
. "${ARH_HOME:?}/lib/common.sh"

apply=0; target=""
while [ $# -gt 0 ]; do
  case "$1" in
    --apply) apply=1; shift ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) arh_die "unexpected option: $1" ;;
    *) [ -z "$target" ] || arh_die "give one study directory"; target="$1"; shift ;;
  esac
done
target=$(cd "${target:-${ARH_PROJECT:-$PWD}}" 2>/dev/null && pwd) || arh_die "cannot resolve the study directory"

if [ -d "$target/.arh" ] && [ ! -L "$target/.arh" ]; then
  if [ -d "$target/.dl" ] && [ ! -L "$target/.dl" ]; then
    arh_die "both .dl/ and .arh/ exist in $target; resolve that by hand"
  fi
  state=migrated
elif [ -d "$target/.dl" ] && [ ! -L "$target/.dl" ]; then
  state=legacy
else
  arh_die "$target has neither a 0.1 state directory (.dl/) nor a current one (.arh/)"
fi

protocol=$(sed -n 's/^# The AutoResearch HPC protocol, v//p' "$ARH_HOME/PROTOCOL.md")
printf 'arh migrate: %s (%s)\n' "$target" "$([ "$state" = legacy ] && echo '0.1 layout' || echo 'state already in .arh/')"
python3 - "$target" "$apply" "$ARH_HOME" "$protocol" "$(cat "$ARH_HOME/VERSION" 2>/dev/null || echo unknown)" \
  "$state" "$(arh_now)" <<'PY'
import os
import re
import shutil
import sys
import tarfile
from pathlib import Path

root, apply, home, protocol, fw_version, state, now = sys.argv[1:8]
root, home, apply = Path(root), Path(home), apply == '1'
state_dir = root / ('.arh' if state == 'migrated' else '.dl')
cfg = state_dir / 'config'
FENCE = re.compile(r'^([ \t]*```[ \t]*)dl-config[ \t]*$', re.M)
BEGIN = '<!-- arh:status:begin — generated by `arh ledger render`; do not edit by hand -->'
changes, rewrites = [], {}


def plan(path, new, why):
    if new != path.read_text():
        rewrites[path] = new
        changes.append(f'{path.relative_to(root)}: {why}')


def config_value(path, key, default):
    inside = False
    for line in (path.read_text().splitlines() if path.exists() else []):
        s = line.strip()
        if s.startswith('```'):
            inside = s[3:].strip() in ('arh-config', 'dl-config')
        elif inside and '=' in s and not s.startswith('#'):
            k, v = s.split('=', 1)
            if k.strip() == key:
                return v.strip()
    return default


if state == 'legacy':
    changes.append('.dl/ -> .arh/, keeping .dl as a symlink: environments built under .dl/ record that prefix')
for p in sorted(cfg.glob('*.md')):
    n = FENCE.sub(r'\1arh-config', p.read_text()).replace('`dl-config`', '`arh-config`')
    n = re.sub(r'`dl (?=[a-z])', '`arh ', n)
    if p.name == 'site.md':
        n = n.replace(f'{root}/.dl/', f'{root}/.arh/')
        n = re.sub(r'(?m)^(image_dir[ \t]*=[ \t]*)\.dl/', r'\1.arh/', n)
    plan(p, n, 'config fence, command names and state paths')
generators = cfg / 'generators.md'
if not generators.exists():
    rewrites[generators] = (home / 'config/generators.md').read_text()
    changes.append(f'{generators.relative_to(root)}: optional external-generator registry added')
# Durable knowledge lives in the project (agent contract rule 10). A study that predates the files
# gets empty templates; existing ones are never touched.
for name in ('DIRECTIVES.md', 'GOTCHAS.md'):
    if not (root / name).exists():
        rewrites[root / name] = (home / 'templates' / name).read_text().replace('{{PROJECT}}', root.name)
        changes.append(f'{name}: added from the template (where directives and gotchas are written)')
for p in sorted((root / 'rules').glob('*.md')):
    plan(p, FENCE.sub(r'\1arh-config', p.read_text()), 'rule fence')
ledger = root / config_value(cfg / 'project.md', 'ledger', 'PROGRESS.md')
if ledger.exists():
    n = re.sub(r'<!--[ \t]*dl:status:begin[^\n]*?-->', BEGIN, ledger.read_text())
    n = re.sub(r'<!--[ \t]*dl:status:end[ \t]*-->', '<!-- arh:status:end -->', n)
    plan(ledger, n, 'status markers (the rest of the record is left as written)')
agents = root / 'AGENTS.md'
if agents.is_file():
    legacy = agents.read_text().startswith('# Automated discovery loop — agent contract')
    plan(agents, (home / 'AGENTS.md').read_text(), '0.1 agent contract replaced (the old one is in the backup)'
         if legacy else "agent contract refreshed from the framework's (the old one is in the backup)")
# Agents read the study's own copies, so a framework update reaches them only through these files.
# Skills the study added itself are left alone.
stale_skills = [(src, root / 'skills' / src.relative_to(home / 'skills'))
                for src in sorted((home / 'skills').rglob('*')) if src.is_file()]
stale_skills = [(src, dst) for src, dst in stale_skills if not dst.is_file() or dst.read_bytes() != src.read_bytes()]
if stale_skills:
    names = [str(dst.relative_to(root / 'skills')) for _, dst in stale_skills]
    changes.append(f'skills/: {len(names)} file(s) copied from the framework: '
                   + ', '.join(names[:6]) + (' …' if len(names) > 6 else ''))
version = state_dir / 'VERSION'
text = version.read_text() if version.exists() else ''
found = re.search(r'(?m)^protocol[ \t]*=[ \t]*(\S+)', text)
if not found or found.group(1) != protocol:
    old = found.group(1) if found else 'unknown'
    new = re.sub(r'(?m)^protocol[ \t]*=.*$', f'protocol = {protocol}', text) if found else f'protocol = {protocol}\n{text}'
    new = new.rstrip('\n') + f'\nmigrated = {now} from protocol {old} by arh migrate (autoresearch-hpc {fw_version})\n'
    rewrites[version] = new
    changes.append(f'{version.relative_to(root)}: protocol {old} -> {protocol}')

# The freeze journal (.arh/freezes.tsv) records each freeze once, so a deleted freeze file cannot
# make a plan freezable again. Studies frozen before it existed get one row per frozen iteration,
# marked as backfilled: the journal can vouch for those freezes only from the migration onwards.
sys.path.insert(0, str(home / 'lib'))
import record  # noqa: E402
iters = root / config_value(cfg / 'project.md', 'iterations_dir', 'iterations')
journal = {r['iteration'] for r in (record.journal_rows(root) or [])} if state == 'migrated' else set()
unjournalled = [d.name for d in sorted(iters.glob('iteration*'))
                if (d / 'PREDECLARATION.sha256').is_file() and d.name[9:] not in journal and not record.journal_era(d)]
if unjournalled:
    changes.append(f'.arh/freezes.tsv: freeze journal rows backfilled for {len(unjournalled)} frozen iteration(s)')

if not changes:
    print('  nothing to do: the study is already on the current layout')
    sys.exit(0)
for change in changes:
    print(('  change: ' if apply else '  would change: ') + change)
if not apply:
    print('\ndry run: nothing was written. Re-run with --apply; a backup is written first.')
    sys.exit(0)

stamp = now.replace('-', '').replace(':', '')
tmp = root / f'.migration-backup-{stamp}.tgz'
with tarfile.open(tmp, 'w:gz') as tar:
    for p in (cfg, state_dir / 'VERSION', state_dir / 'registry.tsv', state_dir / 'freezes.tsv', root / 'rules', ledger,
              agents, root / 'skills'):
        if p.exists():
            tar.add(p, arcname=str(p.relative_to(root)))
if state == 'legacy':
    os.rename(root / '.dl', root / '.arh')
    os.symlink('.arh', root / '.dl')
backup = root / '.arh' / tmp.name.lstrip('.')
os.replace(tmp, backup)
for path, content in rewrites.items():
    path.write_text(content)  # paths under .dl/ now resolve through the symlink
for src, dst in stale_skills:
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dst)
if unjournalled:
    record.backfill(root, iters, now)
print(f'\nbackup: {backup.relative_to(root)}')
print('next: arh ledger render && arh ledger check'
      + ('; replace dl and DL_* in your own scripts by hand' if state == 'legacy' else ''))
PY
[ "$apply" = 1 ] || exit 0
printf '\nchecks:\n'
for check in doctor status 'ledger check'; do
  # shellcheck disable=SC2086  # "ledger check" is two words on purpose
  if ARH_PROJECT="$target" "$ARH_HOME/bin/arh" $check >/dev/null 2>&1; then arh_ok "arh $check"
  else arh_fail "arh $check (run it to see why; arh ledger render usually has to come first)"; fi
done
