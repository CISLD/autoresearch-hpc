#!/usr/bin/env bash
# Bring a study up to this framework: a 0.1 layout (state in .dl/) moves to .arh/, and the study's
# copies of the agent contract (AGENTS.md) and skills/ are refreshed. Dry run by default.
#
#   arh migrate [DIR]                        list every change; nothing is written
#   arh migrate [DIR] --apply [--no-checks] [--force]  write a backup, apply the changes, run the checks
#
# This is the only command that knows the 0.1 names. Iteration and verification files are never
# touched, and re-running it on an up-to-date study changes nothing. AGENTS.md is replaced only
# when it is a shipped version apart from its arh:project block, which is kept (--force: always);
# each applied migration is logged in .arh/migrations.log before the checks run.
set -euo pipefail
# shellcheck source=lib/common.sh
. "${ARH_HOME:?}/lib/common.sh"

apply=0; target=""; checks=1; force=0
while [ $# -gt 0 ]; do
  case "$1" in
    --apply) apply=1; shift ;;
    --no-checks) checks=0; shift ;;
    --force) force=1; shift ;;
    -h|--help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) arh_die "unexpected option: $1" ;;
    *) [ -z "$target" ] || arh_die "give one study directory"; target="$1"; shift ;;
  esac
done
target=$(cd "${target:-${ARH_PROJECT:-$PWD}}" 2>/dev/null && pwd) || arh_die "cannot resolve the study directory"

if [ -d "$target/.arh" ] && [ ! -L "$target/.arh" ]; then
  if [ -d "$target/.dl" ] && [ ! -L "$target/.dl" ]; then
    arh_die "both .dl/ and .arh/ exist in $target; resolve that by hand"
  fi
  state=migrated
elif [ -d "$target/.dl" ] && [ ! -L "$target/.dl" ]; then
  state=legacy
else
  arh_die "$target has neither a 0.1 state directory (.dl/) nor a current one (.arh/)"
fi

protocol=$(sed -n 's/^# The AutoResearch HPC protocol, v//p' "$ARH_HOME/PROTOCOL.md")
printf 'arh migrate: %s (%s)\n' "$target" "$([ "$state" = legacy ] && echo '0.1 layout' || echo 'state already in .arh/')"
fw_commit=$(git -C "$ARH_HOME" rev-parse --short HEAD 2>/dev/null || true)
python3 - "$target" "$apply" "$ARH_HOME" "$protocol" "$(cat "$ARH_HOME/VERSION" 2>/dev/null || echo unknown)" \
  "$state" "$(arh_now)" "$fw_commit" "$force" <<'PY'
import os
import re
import shutil
import subprocess
import sys
import tarfile
from pathlib import Path

root, apply, home, protocol, fw_version, state, now, fw_commit, force = sys.argv[1:10]
force = force == '1'
root, home, apply = Path(root), Path(home), apply == '1'
state_dir = root / ('.arh' if state == 'migrated' else '.dl')
cfg = state_dir / 'config'
FENCE = re.compile(r'^([ \t]*```[ \t]*)dl-config[ \t]*$', re.M)
BEGIN = '<!-- arh:status:begin — generated by `arh ledger render`; do not edit by hand -->'
changes, rewrites, notes = [], {}, []


def plan(path, new, why):
    if new != path.read_text():
        rewrites[path] = new
        changes.append(f'{path.relative_to(root)}: {why}')


def config_value(path, key, default):
    inside = False
    for line in (path.read_text().splitlines() if path.exists() else []):
        s = line.strip()
        if s.startswith('```'):
            inside = s[3:].strip() in ('arh-config', 'dl-config')
        elif inside and '=' in s and not s.startswith('#'):
            k, v = s.split('=', 1)
            if k.strip() == key:
                return v.strip()
    return default


if state == 'legacy':
    changes.append('.dl/ -> .arh/, keeping .dl as a symlink: environments built under .dl/ record that prefix')
for p in sorted(cfg.glob('*.md')):
    n = FENCE.sub(r'\1arh-config', p.read_text()).replace('`dl-config`', '`arh-config`')
    n = re.sub(r'`dl (?=[a-z])', '`arh ', n)
    if p.name == 'site.md':
        n = n.replace(f'{root}/.dl/', f'{root}/.arh/')
        n = re.sub(r'(?m)^(image_dir[ \t]*=[ \t]*)\.dl/', r'\1.arh/', n)
    plan(p, n, 'config fence, command names and state paths')
generators = cfg / 'generators.md'
if not generators.exists():
    rewrites[generators] = (home / 'config/generators.md').read_text()
    changes.append(f'{generators.relative_to(root)}: optional external-generator registry added')
# Durable knowledge lives in the project (agent contract rule 10). A study that predates the files
# gets empty templates; existing ones are never touched.
for name in ('DIRECTIVES.md', 'GOTCHAS.md'):
    if not (root / (config_value(cfg / 'project.md', 'directives', name) if name == 'DIRECTIVES.md' else name)).exists():
        rewrites[root / name] = (home / 'templates' / name).read_text().replace('{{PROJECT}}', root.name)
        changes.append(f'{name}: added from the template (where directives and gotchas are written)')
for p in sorted((root / 'rules').glob('*.md')):
    plan(p, FENCE.sub(r'\1arh-config', p.read_text()), 'rule fence')
ledger = root / config_value(cfg / 'project.md', 'ledger', 'PROGRESS.md')
if ledger.exists():
    n = re.sub(r'<!--[ \t]*dl:status:begin[^\n]*?-->', BEGIN, ledger.read_text())
    n = re.sub(r'<!--[ \t]*dl:status:end[ \t]*-->', '<!-- arh:status:end -->', n)
    plan(ledger, n, 'status markers (the rest of the record is left as written)')
agents = root / 'AGENTS.md'
PROJECT_BLOCK = re.compile(r'(<!-- arh:project:begin[^>]*-->\n?)(.*?)(<!-- arh:project:end -->)', re.S)


def shipped_versions():
    """Every AGENTS.md the framework has shipped (from its git history when ARH_HOME is a checkout),
    with any arh:project block emptied, so a study's copy can be matched against a known base."""
    texts = {(home / 'AGENTS.md').read_text()}
    try:
        revs = subprocess.run(['git', '-C', str(home), 'log', '--format=%H', '--', 'AGENTS.md'],
                              capture_output=True, text=True, timeout=30).stdout.split()
        texts |= {subprocess.run(['git', '-C', str(home), 'show', f'{rev}:AGENTS.md'], capture_output=True,
                                 text=True, timeout=30).stdout for rev in revs}
    except (OSError, subprocess.TimeoutExpired):
        pass
    return {PROJECT_BLOCK.sub(lambda m: m.group(1) + m.group(3), x) for x in texts}


held_agents = False
if agents.is_file():
    current = agents.read_text()
    legacy = current.startswith('# Automated discovery loop — agent contract')
    fresh = (home / 'AGENTS.md').read_text()
    # A study's own text was dropped with the rest of its contract (field feedback #42). Only a copy
    # that is exactly a shipped version, apart from its arh:project block, is replaced; the block is
    # carried over. Anything else is the study's own edit: it is left alone unless --force.
    found = PROJECT_BLOCK.search(current)
    kept = found.group(2) if found else ''
    bare = PROJECT_BLOCK.sub(lambda m: m.group(1) + m.group(3), current)
    if not legacy and not force and bare not in shipped_versions():
        held_agents = True
        notes.append('AGENTS.md: NOT replaced: it has text no framework version shipped. Put the study\'s own '
                       'text between <!-- arh:project:begin --> and <!-- arh:project:end --> (at the end of the '
                       'file) and run migrate again, or pass --force to replace it (the old one goes to the backup)')
    else:
        fresh = PROJECT_BLOCK.sub(lambda m: m.group(1) + kept + m.group(3), fresh, count=1) if kept else fresh
        plan(agents, fresh, '0.1 agent contract replaced (the old one is in the backup)'
             if legacy else "agent contract refreshed from the framework's (the old one is in the backup)"
             + ('; the arh:project block is kept' if kept.strip() else ''))
# Agents read the study's own copies, so a framework update reaches them only through these files.
# Skills the study added itself are left alone.
stale_skills = [(src, root / 'skills' / src.relative_to(home / 'skills'))
                for src in sorted((home / 'skills').rglob('*')) if src.is_file()]
stale_skills = [(src, dst) for src, dst in stale_skills if not dst.is_file() or dst.read_bytes() != src.read_bytes()]
if stale_skills:
    names = [str(dst.relative_to(root / 'skills')) for _, dst in stale_skills]
    changes.append(f'skills/: {len(names)} file(s) copied from the framework: '
                   + ', '.join(names[:6]) + (' …' if len(names) > 6 else ''))
version = state_dir / 'VERSION'
text = version.read_text() if version.exists() else ''
found = re.search(r'(?m)^protocol[ \t]*=[ \t]*(\S+)', text)
# The framework build is recorded too: 0.2.0 -> 0.3.0 kept protocol 0.2.0, so the upgrade left no
# trace (field feedback #43).
framework = f'autoresearch-hpc {fw_version}' + (f' ({fw_commit})' if fw_commit else '')
was = re.search(r'(?m)^framework[ \t]*=[ \t]*(.+)$', text)
if not found or found.group(1) != protocol or not was or was.group(1).strip() != framework:
    old = found.group(1) if found else 'unknown'
    new = re.sub(r'(?m)^protocol[ \t]*=.*$', f'protocol = {protocol}', text) if found else f'protocol = {protocol}\n{text}'
    new = re.sub(r'(?m)^framework[ \t]*=.*$', f'framework = {framework}', new) if was \
        else new.replace(f'protocol = {protocol}\n', f'protocol = {protocol}\nframework = {framework}\n', 1)
    new = new.rstrip('\n') + (f'\nmigrated = {now} from protocol {old}'
                              + (f" ({was.group(1).strip()})" if was else '') + f' by arh migrate ({framework})\n')
    rewrites[version] = new
    changes.append(f'{version.relative_to(root)}: protocol {old} -> {protocol}, framework '
                   + (was.group(1).strip() if was else 'not recorded') + f' -> {framework}')

# The freeze journal (.arh/freezes.tsv) records each freeze once, so a deleted freeze file cannot
# make a plan freezable again. Studies frozen before it existed get one row per frozen iteration,
# marked as backfilled: the journal can vouch for those freezes only from the migration onwards.
sys.path.insert(0, str(home / 'lib'))
import record  # noqa: E402
iters = root / config_value(cfg / 'project.md', 'iterations_dir', 'iterations')
journal = {r['iteration'] for r in (record.journal_rows(root) or [])} if state == 'migrated' else set()
unjournalled = [d.name for d in sorted(iters.glob('iteration*'))
                if (d / 'PREDECLARATION.sha256').is_file() and d.name[9:] not in journal and not record.journal_era(d)]
if unjournalled:
    changes.append(f'.arh/freezes.tsv: freeze journal rows backfilled for {len(unjournalled)} frozen iteration(s)')

# Sealed-input read denials and declared-input access are written into the harness configurations
# by harness/install.sh, which migrate did not run (field feedback #48): refresh the installed ones.
from harness_access import check as access_check  # noqa: E402
access = []
if state == 'migrated':
    reach = config_value(cfg / 'project.md', 'immutable_inputs', '').split()
    shared = config_value(cfg / 'site.md', 'site_gotchas', '')
    if shared:
        reach.append(os.path.dirname(shared))
    web = config_value(cfg / 'harnesses.md', 'web_access', 'allow')
    installed = [h for h, marker in (('claude', root / '.claude'), ('opencode', root / 'opencode.json'))
                 if marker.exists()]
    if installed and access_check(root, web, reach):
        access = installed
        changes.append('harness access: declared inputs, sealed-input denials and web tools refreshed for '
                       + ', '.join(installed))

for note in notes:
    print('  note: ' + note)
if not changes:
    print('  nothing ' + ('else ' if notes else '') + 'to do: the study is already on the current layout')
    sys.exit(0)
for change in changes:
    print(('  change: ' if apply else '  would change: ') + change)
if not apply:
    print('\ndry run: nothing was written. Re-run with --apply; a backup is written first.')
    sys.exit(0)

stamp = now.replace('-', '').replace(':', '')
tmp = root / f'.migration-backup-{stamp}.tgz'
with tarfile.open(tmp, 'w:gz') as tar:
    for p in (cfg, state_dir / 'VERSION', state_dir / 'registry.tsv', state_dir / 'freezes.tsv', root / 'rules', ledger,
              agents, root / 'skills'):
        if p.exists():
            tar.add(p, arcname=str(p.relative_to(root)))
if state == 'legacy':
    os.rename(root / '.dl', root / '.arh')
    os.symlink('.arh', root / '.dl')
backup = root / '.arh' / tmp.name.lstrip('.')
os.replace(tmp, backup)
for path, content in rewrites.items():
    path.write_text(content)  # paths under .dl/ now resolve through the symlink
for src, dst in stale_skills:
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dst)
if unjournalled:
    record.backfill(root, iters, now)
if access:
    from harness_access import write as access_write  # noqa: E402
    for h in access:
        access_write(root, h, web, reach)
# Logged before the checks: a migrate killed while they ran lost its whole report (#55).
with open(root / '.arh/migrations.log', 'a') as log:
    log.write(f'## {now} arh migrate --apply ({framework})\n' + ''.join(f'- {c}\n' for c in changes)
              + f'- backup: {backup.relative_to(root)}\n\n')
print(f'\nbackup: {backup.relative_to(root)}; this list is in .arh/migrations.log')
print('next: arh ledger render && arh ledger check'
      + ('; replace dl and DL_* in your own scripts by hand' if state == 'legacy' else ''))
PY
[ "$apply" = 1 ] && [ "$checks" = 1 ] || exit 0
# status and ledger check hash every iteration: 10–25 minutes on CephFS for 54 iterations, with no
# output until the end (field feedback #44). Say what runs, and how long it took.
printf '\nchecks (arh status and arh ledger check hash every iteration; on a large study they take minutes):\n'
for check in doctor status 'ledger check'; do
  printf '  ...  arh %s\r' "$check"
  started=$(date +%s)
  # shellcheck disable=SC2086  # "ledger check" is two words on purpose
  if ARH_PROJECT="$target" "$ARH_HOME/bin/arh" $check >/dev/null 2>&1; then arh_ok "arh $check ($(( $(date +%s) - started )) s)"
  else arh_fail "arh $check (run it to see why; arh ledger render usually has to come first)"; fi
done
