#!/usr/bin/env bash
# Show every iteration, its claim, and where it stands against the gates.
set -euo pipefail
# shellcheck source=lib/common.sh
. "${ARH_HOME:?}/lib/common.sh"
json=0; running=0
while [ $# -gt 0 ]; do
  case "$1" in
    --json) json=1; shift ;;
    --running) running=1; shift ;;
    --help) echo 'usage: arh status [--json] [--running]'; exit 0 ;;
    *) shift ;;
  esac
done
arh_load_project

# What is running now: live submissions with their trace counts, reviews, and noted scheduler jobs.
if [ "$running" = 1 ]; then
  exec python3 "$ARH_HOME/lib/running.py" "$ARH_ROOT" "$ARH_ITERS" "$ARH_VERIFY" "$(arh_config_get "$ARH_SITE" scheduler local)"
fi

# Machine-readable form, so `arh` is a usable API and callers need not scrape text.
if [ "$json" = 1 ]; then
  iters=$(find "$ARH_ITERS" -maxdepth 1 -type d -name 'iteration*' 2>/dev/null \
          | sed -n 's|.*/iteration\([0-9]\{1,\}\)$|\1|p' | sort -n)
  jsonroot=$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$ARH_ROOT")
  printf '{\n  "project": %s,\n  "iterations": [' "$jsonroot"
  attempts=$(python3 "$ARH_HOME/lib/attempts.py" json "$ARH_ITERS")
  first=1
  for d in $iters; do
    dir="$ARH_ITERS/iteration$d"
    if [ -f "$dir/PREDECLARATION.sha256" ]; then
      [ "$(head -1 "$dir/PREDECLARATION.sha256")" = "$(arh_sha256 "$dir/README.md" 2>/dev/null)" ] \
        && pre=frozen || pre=altered
    elif [ -f "$dir/README.md" ]; then pre=draft; else pre=none; fi
    [ -f "$dir/results/report/iteration${d}_report.md" ] && res=report \
      || { [ -n "$(find "$dir/results" -type f 2>/dev/null | head -1)" ] && res=partial || res=none; }
    xc=$(arh_crosschecks "$dir" | grep -c . || true)
    if [ -f "$dir/DAG.sha256" ]; then dag=frozen
    elif [ -f "$dir/DAG.md" ]; then dag=draft; else dag=none; fi
    narms=$(find "$dir/arms" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | grep -c . || true)
    if [ ! -f "$dir/FREEZE.json" ]; then frz=none
    elif python3 "$ARH_HOME/lib/freeze.py" check "$ARH_ROOT" "$dir" >/dev/null 2>&1; then frz=valid; else frz=changed; fi
    [ "$first" = 1 ] && first=0 || printf ','
    notes=$(grep -c . "$dir/metadata/notes.jsonl" 2>/dev/null || true)
    attempt=$(python3 -c 'import json, sys; print(json.dumps(json.loads(sys.argv[1]).get(sys.argv[2], {})))' "$attempts" "$d")
    printf '\n    {"iteration": %s, "predeclaration": "%s", "results": "%s", "crosschecks": %s, "dag": "%s", "arms": %s, "harness_config": "%s", "freeze": "%s", "notes": %s, "attempt": %s}' \
      "$d" "$pre" "$res" "$xc" "$dag" "$narms" "$(arh_harness_config_state "$dir")" "$frz" "${notes:-0}" "$attempt"
  done
  printf '\n  ]\n}\n'
  exit 0
fi

printf '%s\n' "$ARH_ROOT"
printf 'scheduler=%s  containers=%s  producer=%s  verifier=%s\n\n' \
  "$(arh_config_get "$ARH_SITE" scheduler local)" \
  "$(arh_config_get "$ARH_SITE" container_runtime none)" \
  "$(arh_config_get "$ARH_HARN" producer claude)" \
  "$(arh_config_get "$ARH_HARN" verifier codex)"

printf '%-5s %-12s %-11s %-9s %-7s %s\n' IT AGENT PREDECL RESULTS XCHECK TITLE
printf '%-5s %-12s %-11s %-9s %-7s %s\n' ----- ------------ ----------- --------- ------- -----
found=0; changed=""; noted=""
iters=$(find "$ARH_ITERS" -maxdepth 1 -type d -name 'iteration*' 2>/dev/null \
        | sed -n 's|.*/iteration\([0-9]\{1,\}\)$|\1|p' | sort -n)
for d in $iters; do
  found=1
  dir="$ARH_ITERS/iteration$d"
  agent=$(sed -n 's/.*"declared_agent"[ ]*:[ ]*"\([^"]*\)".*/\1/p' "$dir/CLAIM.json" 2>/dev/null | head -1)
  title=$(sed -n 's/.*"title"[ ]*:[ ]*"\(.*\)",\{0,1\}$/\1/p' "$dir/CLAIM.json" 2>/dev/null | head -1)

  if   [ -f "$dir/PREDECLARATION.sha256" ]; then
    if [ "$(head -1 "$dir/PREDECLARATION.sha256")" = "$(arh_sha256 "$dir/README.md" 2>/dev/null)" ]
    then pre=frozen; else pre=ALTERED; fi
  elif [ -f "$dir/README.md" ]; then pre=draft
  else pre=-; fi

  [ -f "$dir/results/report/iteration${d}_report.md" ] && res=report \
    || { [ -n "$(find "$dir/results" -type f 2>/dev/null | head -1)" ] && res=partial || res=-; }
  [ "$res" != report ] || [ "$(python3 "$ARH_HOME/lib/attempts.py" state "$dir")" != concluded ] || res=concluded

  arh_crosschecks "$dir" | grep -q . && xc=yes || xc=-

  printf '%-5s %-12s %-11s %-9s %-7s %s\n' "$d" "${agent:--}" "$pre" "$res" "$xc" "${title:0:48}"
  [ "$(arh_harness_config_state "$dir")" != changed ] || changed="$changed $d"
  [ ! -s "$dir/metadata/notes.jsonl" ] || noted="$noted $d($(grep -c . "$dir/metadata/notes.jsonl"))"
done
[ "$found" = 0 ] && printf '(no iterations yet — arh claim -t "your question")\n'
[ -z "$changed" ] || printf '\nWARN .arh/config/harnesses.md changed since iteration(s)%s were claimed: a new review of\n     them counts only with arh ask --terms-changed REASON.\n' "$changed"
open=$(python3 "$ARH_HOME/lib/lease.py" open "$ARH_ITERS" "$(arh_config_get "$ARH_PROJ" lease_stale_hours 24)")
[ -z "$open" ] || printf '\nopen iterations (arh lease show -n N; arh status --running for what runs now):\n%s\n' "$open"
[ -z "$noted" ] || printf '\nwork outside arh submit, without run receipts (arh note list):%s\n' "$noted"
vrows=$(python3 "$ARH_HOME/lib/verification.py" rows "$ARH_ROOT" "$ARH_VERIFY")
if [ -n "$vrows" ]; then
  printf '\nverifications (arh verify list):\n'
  printf '%s\n' "$vrows" | awk -F'\t' '{ printf "  %-28s of %-4s %-8s %s\n", $1, $2, $3, $4 }'
fi
if [ -n "$(arh_config_get "$ARH_PROJ" sealed_inputs "")" ] || compgen -G "$ARH_ITERS/iteration*/FREEZE.json" >/dev/null; then
  printf '\nfreezes and sealed inputs (arh freeze list):\n'
  python3 "$ARH_HOME/lib/freeze.py" list "$ARH_ROOT" "$ARH_ITERS" | sed 's/^/  /'
fi
exit 0
