#!/usr/bin/env bash
# Freeze the decision artefacts a confirmation applies, before it reads held-out data.
#
#   arh freeze -n N [--unseal GROUP[,GROUP]] PATH...   hash every file under each PATH into
#                               iterationN/FREEZE.json (write-once); release those sealed groups to it
#   arh freeze check -n N       do the frozen files still match?
#   arh freeze list             freezes, and which iterations read each sealed input
#   arh freeze preseal -n N --reason TEXT [PATH...]   record that iteration N read sealed paths
#                               before they were sealed (all sealed paths when none are named)
#
# With sealed inputs declared in .arh/config/project.md (sealed_inputs, sealed_inputs_<group>, or
# either with _file naming a list), a run of iteration N can read a group only while FREEZE.json
# names it and every frozen file still matches; arh submit records each such read. With one group,
# --unseal is implied; with several, it is required.
set -euo pipefail
# shellcheck source=lib/common.sh
. "${ARH_HOME:?}/lib/common.sh"

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }
sub=create
case "${1-}" in
  -h|--help|"") usage; exit 0 ;;
  check|list|preseal) sub="$1"; shift ;;
esac
n=""; paths=(); unseal=-; reason=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--iteration) n="${2-}"; shift 2 ;;
    --unseal) unseal="${2-}"; shift 2 ;;
    --reason) reason="${2-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) arh_die "unexpected option: $1" ;;
    *) paths+=("$1"); shift ;;
  esac
done
arh_load_project

if [ "$sub" = list ]; then
  exec python3 "$ARH_HOME/lib/freeze.py" list "$ARH_ROOT" "$ARH_ITERS"
fi
case "$n" in ""|*[!0-9]*) arh_die "which iteration? arh freeze $([ "$sub" = check ] && echo 'check ')-n N" ;; esac
dir="$ARH_ITERS/iteration$n"
[ -f "$dir/CLAIM.json" ] || arh_die "no claimed iteration $n"

if [ "$sub" = check ]; then
  exec python3 "$ARH_HOME/lib/freeze.py" check "$ARH_ROOT" "$dir"
fi
if [ "$sub" = preseal ]; then
  exec python3 "$ARH_HOME/lib/freeze.py" preseal "$ARH_ROOT" "$n" "$reason" "${paths[@]}"
fi
[ ${#paths[@]} -gt 0 ] || arh_die "name what the confirmation applies: arh freeze -n $n MODEL THRESHOLDS SCRIPTS..."
arh_guard_path "$dir/FREEZE.json"
arh_lease_touch "$dir" "arh freeze"
exec python3 "$ARH_HOME/lib/freeze.py" create "$ARH_ROOT" "$dir" "$(arh_agent_name)" "$unseal" "${paths[@]}"
