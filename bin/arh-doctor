#!/usr/bin/env bash
# Check the local/HPC environment and print concrete setup actions.
set -euo pipefail
. "${ARH_HOME:?}/lib/common.sh"
smoke=""; probe=0
case "${1-}" in
  --help|-h) echo 'usage: arh doctor [--smoke [gpu]] [--probe]
--smoke runs one task through the configured scheduler and task image and checks what it can see:
the task environment, a writable project, read-only immutable inputs, hidden sealed inputs, and with
gpu a GPU in a task labelled gpu. It waits for the scheduler.
--probe sends a one-line prompt to the verifier and each verifier_fallback, so an expired login, a
used-up quota or a missing CLI shows before an iteration needs its review. It is a model call.'; exit 0 ;;
  --smoke) smoke=cpu; [ "${2-}" != gpu ] || smoke=gpu ;;
  --probe) probe=1 ;;
esac
warn=0
printf 'AutoResearch HPC  ARH_HOME=%s\n\n' "$ARH_HOME"

if (arh_find_project) >/dev/null 2>&1; then
  arh_load_project
  arh_ok "project: $ARH_ROOT"
  framework=$(sed -n 's/^# The AutoResearch HPC protocol, v//p' "$ARH_HOME/PROTOCOL.md")
  recorded=$(sed -n 's/^protocol *= *//p' "$ARH_STATE/VERSION" 2>/dev/null | head -1)
  if [ -z "$recorded" ]; then arh_warn "no protocol recorded in .arh/VERSION"
  elif [ "$recorded" = "$framework" ]; then arh_ok "state: .arh, protocol $recorded"
  else
    arh_fail "project records protocol $recorded, the framework is $framework — run: arh migrate $ARH_ROOT"
    warn=$((warn+1))
  fi
  # Agents read the study's copies of AGENTS.md and skills/, which a framework update does not touch.
  drift=$(python3 - "$ARH_HOME" "$ARH_ROOT" <<'PY'
import re
import sys
from pathlib import Path
home, root = map(Path, sys.argv[1:3])
files = [Path('AGENTS.md')] + [p.relative_to(home) for p in sorted((home / 'skills').rglob('*')) if p.is_file()]
block = re.compile(rb'(<!-- arh:project:begin[^>]*-->).*?(<!-- arh:project:end -->)', re.S)


def body(path):   # the study's own arh:project block is not drift
    data = path.read_bytes()
    return block.sub(rb'\1\2', data) if path.name == 'AGENTS.md' else data
print(sum(1 for f in files if not (root / f).is_file() or body(root / f) != body(home / f)))
PY
)
  if [ "${drift:-0}" = 0 ]; then arh_ok "agent contract and skills match the framework"
  else arh_warn "$drift agent-facing file(s) (AGENTS.md, skills/) differ from the framework's; arh migrate $ARH_ROOT lists them"; fi
else
  arh_warn "not inside a project"
  arh_info "create one with: arh init /shared/my-study"
  exit 0
fi

printf '\nexecution:\n'
sched=$(arh_config_get "$ARH_SITE" scheduler local)
# Where this session runs (S2): centres ask agents to stay light on login nodes and run inside an
# allocation, and an agent session on a login node may break a site's policy without anyone noticing.
if [ -n "${SLURM_JOB_ID:-}" ]; then arh_ok "running inside Slurm job $SLURM_JOB_ID on $(uname -n)"
elif [ -n "${PBS_JOBID:-}" ]; then arh_ok "running inside PBS job $PBS_JOBID on $(uname -n)"
elif [ "$sched" != local ]; then
  arh_info "running on $(uname -n) outside a scheduler allocation: if this is a login node, keep the agent a light driver and check the site's policy for long sessions"
fi
case "$sched" in
  slurm)
    missing=""
    for c in sbatch squeue scancel; do command -v "$c" >/dev/null || missing="$missing $c"; done
    [ -z "$missing" ] && arh_ok "scheduler slurm" || { arh_fail "scheduler=slurm; missing:$missing"; warn=$((warn+1)); }
    ;;
  pbs)
    command -v qsub >/dev/null && arh_ok "scheduler pbs" || { arh_fail "scheduler=pbs but qsub is missing"; warn=$((warn+1)); }
    ;;
  local) arh_ok "scheduler local" ;;
  *) arh_fail "unknown scheduler: $sched"; warn=$((warn+1)) ;;
esac

ctr=$(arh_config_get "$ARH_SITE" container_runtime none)
case "$ctr" in
  singularity)
    command -v singularity >/dev/null && arh_ok "container command: singularity" || { arh_fail "singularity not on PATH"; warn=$((warn+1)); }
    ;;
  apptainer)
    command -v apptainer >/dev/null && arh_ok "container command: apptainer" || { arh_fail "apptainer not on PATH"; warn=$((warn+1)); }
    ;;
  docker)
    command -v docker >/dev/null && arh_ok "container command: docker" || { arh_fail "docker not on PATH"; warn=$((warn+1)); }
    ;;
  none) arh_warn "container_runtime=none — suitable only for smoke tests" ;;
  *) arh_fail "unknown container_runtime: $ctr"; warn=$((warn+1)) ;;
esac

prefix=$(arh_config_get "$ARH_SITE" nextflow_prefix "")
if [ -n "$prefix" ] && [ -x "$prefix/bin/nextflow" ]; then
  arh_ok "pinned host Nextflow: $prefix/bin/nextflow"
else
  arh_fail "host Nextflow environment is not configured"
  arh_info "fix: $ARH_HOME/scripts/setup-nextflow.sh $ARH_ROOT"
  arh_info "     this bootstraps a checksum-pinned project-local micromamba if needed"
  arh_info "     offline/custom: scripts/setup-nextflow.sh PROJECT /path/to/micromamba"
  warn=$((warn+1))
fi

image=$(arh_config_get "$ARH_SITE" runtime_image "")
if [ -n "$image" ] && [ -f "$image" ]; then
  expected=$(arh_config_get "$ARH_SITE" runtime_sha256 "")
  [ -n "$expected" ] && [ "$(arh_sha256 "$image")" = "$expected" ] && arh_ok "task runtime image is present and digest-matched" \
    || { arh_fail "runtime image digest is missing or does not match"; warn=$((warn+1)); }
else
  arh_warn "no task runtime SIF configured"
  arh_info "fix: $ARH_HOME/scripts/setup-runtime.sh $ARH_ROOT /shared/images/runtime.sif"
fi

printf '\nharnesses:\n'
producer=$(arh_config_get "$ARH_HARN" producer "")
verifier=$(arh_config_get "$ARH_HARN" verifier "")
for h in $(arh_config_get "$ARH_HARN" harnesses ""); do
  c=$(arh_config_get "$ARH_HARN" "harness_${h}_cmd" ""); fam=$(arh_config_get "$ARH_HARN" "harness_${h}_family" '?')
  if command -v "${c%% *}" >/dev/null 2>&1; then arh_ok "$h ($fam) — ${c%% *} present"
  else arh_warn "$h ($fam) — ${c%% *} not installed"; fi
done
pf=$(arh_config_get "$ARH_HARN" "harness_${producer}_family" a)
vf=$(arh_config_get "$ARH_HARN" "harness_${verifier}_family" b)
strict_family=$(arh_config_get "$ARH_HARN" require_foreign_family true)
if [ "$pf" != "$vf" ]; then arh_ok "producer $producer ($pf) != verifier $verifier ($vf)"
elif [ "$strict_family" = false ]; then
  arh_warn "producer ($producer) and verifier ($verifier) share family '$pf'; accepted because
       require_foreign_family = false. A model does not reliably catch its own reasoning errors,
       so every review taken this way is a weaker check and the record says so."
else arh_fail "producer ($producer) and verifier ($verifier) share family '$pf'"; warn=$((warn+1)); fi
# A review is ineligible unless BOTH families are concrete, and that is only discovered at
# the results gate, after the work is done. Say so here instead.
for pair in "producer:$producer:$pf" "verifier:$verifier:$vf"; do
  role=${pair%%:*}; rest=${pair#*:}; h=${rest%%:*}; ff=${rest#*:}
  case "$ff" in
    unknown|mixed|""|a|b)
      arh_fail "$role $h has no concrete model family ($ff): every review it takes part in is INELIGIBLE at the results gate.
       A router harness (one CLI in front of several providers) must pin its model in
       harness_${h}_cmd and declare that model's family in harness_${h}_family."
      warn=$((warn+1)) ;;
  esac
done
for h in $(arh_config_get "$ARH_HARN" verifier_fallback ""); do
  ff=$(arh_config_get "$ARH_HARN" "harness_${h}_family" unknown)
  case "$ff" in
    unknown|mixed|"") arh_fail "verifier_fallback $h has no concrete model family ($ff)"; warn=$((warn+1)) ;;
    "$pf") arh_fail "verifier_fallback $h shares the producer's family '$pf'"; warn=$((warn+1)) ;;
    *) arh_ok "verifier_fallback $h ($ff)" ;;
  esac
done
if [ "$probe" = 1 ]; then
  for h in $verifier $(arh_config_get "$ARH_HARN" verifier_fallback ""); do
    c=$(arh_config_get "$ARH_HARN" "harness_${h}_cmd" "")
    [ -n "$c" ] || { arh_fail "probe $h: no harness_${h}_cmd"; warn=$((warn+1)); continue; }
    if said=$(python3 "$ARH_HOME/lib/harness.py" probe "$c" "$ARH_ROOT" "$(arh_config_get "$ARH_HARN" doctor_probe_timeout 180)"); then
      arh_ok "probe $h answered"
    else arh_fail "probe $h: $said"; warn=$((warn+1)); fi
  done
else
  # A login can expire while the CLI is still installed: "present" above does not mean usable.
  arh_info "verifier logins and quotas are not checked; arh doctor --probe makes one short call to each"
fi
arh_warn_agent_mismatch
web=$(arh_config_get "$ARH_HARN" web_access allow)
case "$web" in allow|deny) ;; *) arh_fail "web_access must be allow or deny, not '$web'"; warn=$((warn+1)); web=allow ;; esac
reach=$(arh_config_get "$ARH_PROJ" immutable_inputs "")
shared=$(arh_config_get "$ARH_SITE" site_gotchas "")
[ -z "$shared" ] || reach="$reach $(dirname "$shared")"
# shellcheck disable=SC2086  # immutable_inputs is a space-separated list
access=$(python3 "$ARH_HOME/lib/harness_access.py" check "$ARH_ROOT" "$web" $reach)
if [ -z "$access" ]; then arh_ok "harness access: declared inputs reachable, web_access = $web"
else
  while IFS='|' read -r level msg; do
    if [ "$level" = FAIL ]; then arh_fail "$msg"; warn=$((warn+1)); else arh_warn "$msg"; fi
  done <<< "$access"
  arh_info "fix: $ARH_HOME/harness/install.sh $ARH_ROOT <harness> writes these entries"
fi

printf '\ndelegation roles (optional):\n'
if [ -z "$(arh_config_get "$ARH_HARN" orchestrator "")$(arh_config_get "$ARH_HARN" executor "")" ]; then
  printf '  none configured; one agent does both planning and implementation\n'
else
  for r in orchestrator executor; do
    rh=$(arh_config_get "$ARH_HARN" "$r" "")
    if [ -z "$rh" ]; then arh_warn "$r unset while the other role is configured"
    elif [ -z "$(arh_config_get "$ARH_HARN" "harness_${rh}_cmd" "")" ]; then
      arh_fail "$r = $rh has no harness_${rh}_cmd"; warn=$((warn+1))
    else arh_ok "$r $rh ($(arh_config_get "$ARH_HARN" "harness_${rh}_family" unknown))"; fi
  done
fi

printf '\nexternal generators (optional):\n'
if [ ! -f "$ARH_GENS" ]; then
  arh_warn "no generators.md; run: arh migrate $ARH_ROOT"
else
  for g in $(arh_config_get "$ARH_GENS" generators ""); do
    enabled=$(arh_config_get "$ARH_GENS" "generator_${g}_enabled" false)
    cmd=$(arh_config_get "$ARH_GENS" "generator_${g}_cmd" "")
    if [ "$enabled" != true ]; then
      arh_info "$g — disabled"
      continue
    fi
    if [ -z "$cmd" ]; then
      arh_fail "$g — enabled but generator_${g}_cmd is empty"
      warn=$((warn+1))
      continue
    fi
    exe=$(python3 -c 'import shlex,sys; p=shlex.split(sys.argv[1]); print(p[0] if p else "")' "$cmd" 2>/dev/null || true)
    if { case "$exe" in /*) [ -x "$exe" ] ;; *) command -v "$exe" >/dev/null 2>&1 ;; esac; }; then
      arh_ok "$g — enabled; $exe present"
    else
      arh_fail "$g — enabled; command not found: $exe"
      warn=$((warn+1))
    fi
  done
fi

printf '\nknowledge:\n'
# Facts that outlive a session belong in the project, where every harness and the reviewer read them
# (agent contract rule 10). A study once ran on directives held only in one harness's private memory.
for f in DIRECTIVES.md GOTCHAS.md; do
  if [ -f "$ARH_ROOT/$f" ]; then arh_ok "$f"
  else
    arh_warn "$f is missing, so what it should hold lives only in some session's memory; fix: arh migrate $ARH_ROOT --apply"
  fi
done
if [ -f "$ARH_ROOT/AGENTS.md" ] && ! grep -q 'never only in private memory' "$ARH_ROOT/AGENTS.md"; then
  arh_warn "AGENTS.md does not tell agents where durable knowledge goes; fix: arh migrate $ARH_ROOT --apply"
fi
if [ -f "$ARH_ROOT/GOTCHAS.md" ]; then
  bare=$(python3 - "$ARH_ROOT/GOTCHAS.md" <<'PY'
import re, sys
text = open(sys.argv[1]).read()
for name, body in re.findall(r'^## (.+?)\n(.*?)(?=^## |\Z)', text, re.M | re.S):
    if not name.lower().startswith(('example', '<')) and 'assertion' not in body.lower():
        print(name.strip()[:60])
PY
)
  [ -z "$bare" ] || arh_warn "GOTCHAS.md entries without an assertion (a failure mode nobody can detect recurs): $(printf '%s' "$bare" | paste -sd';' -)"
fi
site_gotchas=$(arh_config_get "$ARH_SITE" site_gotchas "")
if [ -n "$site_gotchas" ]; then
  if [ -r "$site_gotchas" ] && [ -f "$site_gotchas" ]; then
    arh_ok "site_gotchas: $site_gotchas$([ -w "$site_gotchas" ] || printf ' (read-only for you)')"
  else arh_fail "site_gotchas names $site_gotchas, which is not a readable file"; warn=$((warn+1)); fi
fi

if [ -n "$(arh_config_get "$ARH_PROJ" sealed_inputs "")" ]; then
  printf '\nsealed inputs:\n'
  while IFS='|' read -r level msg; do
    case "$level" in
      OK) arh_ok "$msg" ;;
      FAIL) arh_fail "$msg"; warn=$((warn+1)) ;;
      *) arh_warn "$msg" ;;
    esac
  done < <(python3 "$ARH_HOME/lib/freeze.py" doctor "$ARH_ROOT")
fi

printf '\nrules:\n'
for r in $(arh_config_get "$ARH_PROJ" rules ""); do
  [ -f "$ARH_ROOT/rules/$r.md" ] && arh_ok "$r" || { arh_fail "$r — configured but missing"; warn=$((warn+1)); }
done

if [ -f "$ARH_STATE/inputs/checks.jsonl" ]; then
  printf '\ninputs:\n'
  summary=$(python3 "$ARH_HOME/lib/inputs.py" summary "$ARH_ROOT")
  failed=$(printf '%s' "$summary" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(len(d["failed"]) if d else 0)')
  if [ "$failed" = 0 ]; then arh_ok "every checked input passed its last integrity check (arh inputs list)"
  else arh_warn "$failed input file(s) failed their last integrity check (arh inputs list)"; fi
fi

# Binaries existing is not the boundary working: run one task through it (field feedback #5).
if [ -n "$smoke" ]; then
  printf '\nsmoke test (one task through scheduler %s and the task image):\n' "$sched"
  if [ "$warn" -gt 0 ]; then
    arh_fail "skipped: fix the setup problems above first"; warn=$((warn+1))
  else
    mkdir -p "$ARH_STATE/smoke"
    python3 - "$ARH_ROOT" "$ARH_STATE/smoke/params.json" "$smoke" "$ARH_HOME" <<'PY'
import json, os, sys
from pathlib import Path
root, out, mode, home = sys.argv[1:5]
sys.path.insert(0, home + '/lib')
from project import config
from freeze import sealed_inputs
immutable = [os.path.realpath(p if os.path.isabs(p) else os.path.join(root, p))
             for p in config(Path(root) / '.arh/config/project.md').get('immutable_inputs', '').split()]
Path(out).write_text(json.dumps(dict(immutable=immutable, sealed=[str(p) for p in sealed_inputs(root)],
                                     gpu=mode == 'gpu'), indent=2) + '\n')
PY
    if "$ARH_HOME/bin/arh" submit "$ARH_HOME/workflows/smoke.nf" -n smoke --params "$ARH_STATE/smoke/params.json" >/dev/null 2>"$ARH_STATE/smoke/submit.err"
    then rc=0; else rc=$?; fi
    attempt=$(find "$ARH_STATE/smoke/logs/nextflow/smoke" -maxdepth 1 -name 'attempt-*' -type d -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-)
    if [ -z "$attempt" ]; then
      arh_fail "the smoke submission did not start: $(tail -3 "$ARH_STATE/smoke/submit.err" | tr '\n' ' ')"; warn=$((warn+1))
    else
      while IFS= read -r line; do
        case "$line" in
          ok\ *) arh_ok "${line#ok   }" ;;
          FAIL\ *) arh_fail "${line#FAIL }"; warn=$((warn+1)) ;;
        esac
      done < <(grep -E '^(ok|FAIL) ' "$attempt/console.log")
      done_tasks=$(awk -F'\t' 'NR>1 && $5=="COMPLETED"' "$attempt/trace.tsv" 2>/dev/null | grep -c . || true)
      if [ "$rc" = 0 ] && [ "${done_tasks:-0}" -ge 1 ]; then
        arh_ok "the task ran through the scheduler and completed (evidence: ${attempt#"$ARH_ROOT"/})"
      else
        arh_fail "the smoke submission exited $rc with ${done_tasks:-0} completed task(s); see ${attempt#"$ARH_ROOT"/}/console.log"
        warn=$((warn+1))
      fi
    fi
  fi
fi

printf '\n'
[ "$warn" -gt 0 ] && { printf '%s setup problem(s) found. Fix the FAIL items above and rerun `arh doctor`.\n' "$warn"; exit 1; }
printf 'Ready. Next: arh claim -t "your first question"\n'
