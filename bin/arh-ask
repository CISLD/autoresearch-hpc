#!/usr/bin/env bash
# Cross-check with a foreign harness.
#
# The point is the *foreign* part. A model reviewing its own output checks
# whether the work looks correctly generated, not whether it is correct — it
# reproduces the reasoning errors it made while generating. So by default the
# verifying harness must belong to a different model family than the producer.
set -euo pipefail
# shellcheck source=lib/common.sh
. "${ARH_HOME:?}/lib/common.sh"

role=adversary; n=""; harness=""; same_family=0; dry=0; extra=""; terms_reason=""; rebuttal=0
while [ $# -gt 0 ]; do
  case "$1" in
    --role)         role="$2"; shift 2 ;;
    -n|--iteration) n="$2"; shift 2 ;;
    --harness)      harness="$2"; shift 2 ;;
    --same-family)  same_family=1; shift ;;
    --dry-run)      dry=1; shift ;;
    --note)         extra="$2"; shift 2 ;;
    --terms-changed) terms_reason="$2"; shift 2 ;;
    --rebuttal)     rebuttal=1; shift ;;
    -h|--help) echo 'usage: arh ask --role {adversary|reimplementer|estimand-auditor|gotcha-scanner} -n N [--harness H] [--same-family] [--dry-run] [--note TEXT] [--terms-changed REASON]
       arh ask --rebuttal -n N [--harness H] [--dry-run] [--note TEXT] [--terms-changed REASON]
--rebuttal: put the producer'"'"'s rebuttal of an UNSOUND review to a reviewer (by default the one who said
UNSOUND), who answers ADJUDICATION: WITHDRAWN or MAINTAINED. At most ask_max_adjudications per review.
--terms-changed: required when .arh/config/harnesses.md changed since iteration N was claimed; the reason is kept in the review record.
exit 75: provider usage/rate limit, authentication (also an expired key) or a timeout; 77: provider refused the
content. Neither spends a review round, and each tries verifier_fallback.'; exit 0 ;;
    *) arh_die "unexpected argument: $1" ;;
  esac
done
case "$n" in ""|*[!0-9]*) arh_die "iteration must be numeric" ;; esac
case "$role:$harness" in *..*|*/*) arh_die "invalid role or harness" ;; esac
[ -n "$n" ] || arh_die "which iteration? arh ask --role $role -n N"

arh_load_project

# Whether a review must come from a different model family than the producer. True by default;
# a project that sets it false accepts a same-family adversarial review as a full cross-check, and
# every review records which rule it ran under so the gate does not change meaning retroactively.
strict_family=$(arh_config_get "$ARH_HARN" require_foreign_family true)
case "$strict_family" in true|false) ;; *) arh_die "require_foreign_family must be true or false, not '$strict_family'" ;; esac
[ "$strict_family" = true ] && strict_arg=1 || strict_arg=0
dir="$ARH_ITERS/iteration$n"
[ -d "$dir" ] || arh_die "no iteration $n"
[ -f "$dir/PREDECLARATION.sha256" ] || arh_die "iteration is not frozen"
[ "$(head -1 "$dir/PREDECLARATION.sha256")" = "$(arh_sha256 "$dir/README.md")" ] || arh_die "pre-declaration altered"
# The review terms were bound to the iteration when it was claimed. Refuse before any model call:
# a review under changed terms counts only with the reason on record.
if [ "$(arh_harness_config_state "$dir")" = changed ] && [ -z "${terms_reason//[[:space:]]/}" ]; then
  arh_die ".arh/config/harnesses.md changed since iteration $n was claimed, so the terms of this review
       (verifier, fallbacks, family rule, bounds) are not the ones the iteration was claimed under.
       Compare with ${dir#"$ARH_ROOT"/}/metadata/harnesses.claimed.md, then either restore it, or pass
       --terms-changed 'what changed and why' to record the reason with the review, or claim a new
       iteration under the new terms."
fi

roledoc="$ARH_HOME/skills/cross-check/roles/$role.md"
[ -f "$roledoc" ] || arh_die "unknown role: $role (see skills/cross-check/roles/)"

# Standing rules are enforced again by `arh gate results`, but only after the review. A report
# that fails them then has to be edited, which invalidates the hash-bound review and costs a
# round. Check first, while fixing the report is still free.
report_file="$dir/results/report/iteration${n}_report.md"
if [ "$rebuttal" = 0 ] && [ "$role" != reimplementer ] && [ -f "$report_file" ]; then
  if ! rule_out=$("$ARH_HOME/bin/arh" gate rules "$report_file" 2>&1); then
    printf '%s\n' "$rule_out" | grep -E 'FAIL' >&2 || true
    arh_die "the report fails the standing rules; fix it before review (arh gate rules ${report_file#"$ARH_ROOT"/}).
       Editing a report after its review invalidates the review."
  fi
fi

producer=$(arh_config_get "$ARH_HARN" producer claude)
# With per-iteration controllers, the iteration's producing agent is the controller it was
# dispatched to, and an executor may have written the analysis: the verifier must differ from both.
executor=""; efam=""
if [ "$(arh_config_get "$ARH_HARN" orchestration single)" = per-iteration ]; then
  ctl=$(python3 "$ARH_HOME/lib/dispatch.py" controller "$dir")
  [ -z "$ctl" ] || producer=$ctl
  executor=$(arh_config_get "$ARH_HARN" executor "")
  [ -z "$executor" ] || efam=$(arh_config_get "$ARH_HARN" "harness_${executor}_family" unknown)
fi
case "$producer$executor" in *..*|*/*) arh_die "invalid configured harness name" ;; esac
pfam=$(arh_config_get "$ARH_HARN" "harness_${producer}_family" unknown)

# Why harness $1 cannot give this review; nothing when it can.
ineligible() {
  local fam
  case "$1" in ""|*..*|*/*) echo "invalid configured harness name"; return ;; esac
  fam=$(arh_config_get "$ARH_HARN" "harness_${1}_family" unknown)
  case "$pfam:$fam" in unknown:*|mixed:*|:*|*:unknown|*:mixed|*:) echo "configure concrete producer and verifier model families"; return ;; esac
  if [ "$pfam" = "$fam" ] && [ "$same_family" = 0 ] && [ "$strict_family" = true ]; then
    echo "producer ($producer/$pfam) and verifier ($1/$fam) are the same model family.
       A model does not reliably catch its own reasoning errors. Choose another harness,
       pass --same-family to record a weaker check that cannot satisfy the results gate, or
       set require_foreign_family = false in .arh/config/harnesses.md to accept same-family
       review as a full cross-check for this project, and record why beside it. For an
       iteration already claimed, that is a change of review terms: add --terms-changed REASON."
    return
  fi
  if [ -n "$efam" ] && [ "$efam" = "$fam" ] && [ "$same_family" = 0 ] && [ "$strict_family" = true ]; then
    echo "the executor ($executor/$efam), which may have written the analysis, and the verifier ($1/$fam) are
       the same model family. With orchestration = per-iteration the verifier must differ from both the
       iteration controller and the executor. Choose another verifier or executor."
    return
  fi
  [ -n "$(arh_config_get "$ARH_HARN" "harness_${1}_cmd" "")" ] \
    || echo "no command configured for harness '$1' (see .arh/config/harnesses.md)"
}

# A rebuttal of an UNSOUND verdict is the producer judging its own case. --rebuttal puts it to a
# reviewer, bound to the review and to the rebuttal's text; one review per call, oldest first.
kind=review; prefix="CROSSCHECK_${role}_"; judging=""; review_h=""
if [ "$rebuttal" = 1 ]; then
  pending=$(python3 "$ARH_HOME/lib/findings.py" pending "$dir")
  [ -n "$pending" ] || arh_die "iteration $n has no rebutted UNSOUND review waiting for a reviewer's judgment.
       A rebuttal is 'Verdict: rebutted, because <reason>' in that review's part of REVIEW_RESPONSE.md;
       arh gate results -n $n shows how each UNSOUND review stands."
  IFS=$'\t' read -r judged_review rebuttal_sha review_h tried <<< "$(printf '%s\n' "$pending" | head -1)"
  max_adj=$(arh_config_get "$ARH_HARN" ask_max_adjudications 1)
  [ "$tried" -lt "$max_adj" ] || arh_die "the rebuttal of ${judged_review##*/} has been put to a reviewer $tried time(s), and
       ask_max_adjudications is $max_adj. A maintained UNSOUND stands: leave this iteration unconcluded and
       record the correction in a new one."
  kind=adjudication; prefix=REBUTTAL_
  judging=$(python3 -c 'import json,sys; print(json.dumps({"adjudicates": sys.argv[1], "review_sha256": sys.argv[2], "rebuttal_sha256": sys.argv[3]}))' \
    "${judged_review##*/}" "$(arh_sha256 "$judged_review")" "$rebuttal_sha")
fi

# An explicit --harness is used alone. Otherwise the configured verifier goes first, and each
# verifier_fallback is tried in turn when a verifier cannot review: a content-policy refusal (77),
# which waiting does not change, or a usage limit (75), whose stated reset is not reliable either.
# A provider once named a reset five days out, and a probe 44 minutes later succeeded (2026-09-16).
# A rebuttal goes first to the reviewer who said UNSOUND.
if [ -n "$harness" ]; then candidates=$harness
elif [ "$kind" = adjudication ] && [ -n "$review_h" ]; then
  candidates="$review_h $(arh_config_get "$ARH_HARN" verifier_fallback "")"
else candidates="$(arh_config_get "$ARH_HARN" verifier codex) $(arh_config_get "$ARH_HARN" verifier_fallback "")"; fi
primary=${candidates%% *}
why=$(ineligible "$primary")
[ -z "$why" ] || arh_die "$why"
# Roles that must not see the original implementation. For these the prompt
# carries the frozen DAG without the implementation. Filesystem isolation must
# be provided externally; prompt omission alone is a cooperative boundary.
blind=0
case "$role" in reimplementer) blind=1 ;; esac

arh_guard_path "$dir"
[ "$dry" = 1 ] || arh_lease_touch "$dir" "$([ "$kind" = review ] && echo "arh ask --role $role" || echo 'arh ask --rebuttal')"
prompt=$(mktemp "$dir/logs/prompt.XXXXXX"); arh_share_mode "$prompt"
lock=""
cleanup() { rm -f "$prompt"; [ -z "$lock" ] || { rm -f "$lock/owner.json"; rmdir "$lock"; }; }
trap cleanup EXIT
if [ "$kind" = adjudication ]; then
  {
    cat "$ARH_HOME/skills/cross-check/rebuttal.md"
    printf '\n---\n\n## The work\n\nProject root: %s\nIteration: %s\n\n' "$ARH_ROOT" "$n"
    printf '### Pre-declaration (written before any result existed)\n\n'
    cat "$dir/README.md"
    printf '\n### Report\n\n'
    [ -f "$report_file" ] && cat "$report_file" || printf '(no report)\n'
    printf '\n---\n\n## The review that returned UNSOUND (%s)\n\n' "${judged_review##*/}"
    cat "$judged_review"
    printf '\n---\n\n## The producer'"'"'s rebuttal\n\n'
    python3 "$ARH_HOME/lib/findings.py" rebuttal "$dir" "$judged_review"
    [ -n "$extra" ] && printf '\n### Additional instruction from the operator\n\n%s\n' "$extra"
    printf '\n---\n\nBegin with a single line:\nADJUDICATION: WITHDRAWN | MAINTAINED\n'
    printf '\nThen give your reasons, citing the evidence above. Keep the response within %s words.\n' \
      "$(arh_config_get "$ARH_HARN" ask_output_words 500)"
  } > "$prompt"
else
{
  cat "$roledoc"
  printf '\n---\n\n## The work under review\n\n'
  if [ "$blind" = 1 ]; then
    dag="$dir/DAG.md"
    [ -f "$dag" ] || arh_die "role '$role' works from the frozen DAG, and iteration $n has none.
       Run: arh dag init -n $n, complete it, then arh dag freeze -n $n"
    [ -f "$dir/DAG.sha256" ] || arh_die "iteration $n has a DAG but it is not frozen (arh dag freeze -n $n)"
    [ "$(head -1 "$dir/DAG.sha256")" = "$(arh_sha256 "$dag")" ] || arh_die "DAG altered"
    printf 'You are working from the discovery DAG ALONE. The original code is\n'
    printf 'deliberately not provided, and you must not go looking for it: it is\n'
    printf 'under %s/scripts/ and reading it voids this check.\n\n' "$dir"
    printf 'Project root: %s   Iteration: %s\n\n' "$ARH_ROOT" "$n"
    printf '### Discovery DAG (frozen %s)\n\n' "$(head -1 "$dir/DAG.sha256")"
    cat "$dag"
    printf '\n### Pre-declaration\n\n'
    [ -f "$dir/README.md" ] && cat "$dir/README.md" || printf '(none)\n'
    [ -n "$extra" ] && printf '\n### Additional instruction\n\n%s\n' "$extra"
    printf '\nDo not use the declared prediction as evidence for your verdict.\n'
  printf '\n---\n\nWrite your findings as Markdown. Begin with a single line:\n'
    printf 'VERDICT: SOUND | QUALIFIED | UNSOUND\n'
    printf '\nThen give, under clear headings: the ambiguities you had to resolve to\n'
    printf 'make the specification runnable; your reproduced value; and — where the\n'
    printf 'object is a set — which elements you got, BY NAME.\n'
  else
  printf 'Project root: %s\nIteration: %s\nDirectory: %s\n\n' "$ARH_ROOT" "$n" "$dir"
  printf 'Standing rules every conclusion inherits are in %s/rules/.\n' "$ARH_ROOT"
  printf 'Recorded silent failure modes are in %s/GOTCHAS.md.\n' "$ARH_ROOT"
  [ ! -f "$ARH_DIRECTIVES" ] || printf 'Operator directives, data locations and external findings the work must follow are in\n%s; check the work against them.\n' "$ARH_DIRECTIVES"
  site_gotchas=$(arh_config_get "$ARH_SITE" site_gotchas "")
  [ -z "$site_gotchas" ] || [ ! -f "$site_gotchas" ] || printf 'Tool and site pitfalls shared across projects are in %s.\n' "$site_gotchas"
  printf '\n'
  printf '### Pre-declaration (written before any result existed)\n\n'
  [ -f "$dir/README.md" ] && cat "$dir/README.md" || printf '(none)\n'
  report="$dir/results/report/iteration${n}_report.md"
  printf '\n### Report\n\n'
  [ -f "$report" ] && cat "$report" || printf '(no report yet)\n'
  [ -n "$extra" ] && printf '\n### Additional instruction from the operator\n\n%s\n' "$extra"
  printf '\nDo not use the declared prediction as evidence for your verdict.\n'
  printf '\n---\n\nWrite your findings as Markdown. Begin with a single line:\n'
  printf 'VERDICT: SOUND | QUALIFIED | UNSOUND\n'
  fi
  printf '\nAfter the VERDICT line, give each finding on its own line, numbered: "F1: ...", "F2: ...",\n'
  printf 'so each can be answered by its id. Write "No findings." when there are none.\n'
  printf '\nKeep the response within %s words. Cite specific evidence; do not expand the task.\n' "$(arh_config_get "$ARH_HARN" ask_output_words 500)"
} > "$prompt"
fi
# A credential pasted into a plan or report would leave the site with the review request.
sources=("$dir/README.md")
[ ! -f "$dir/results/report/iteration${n}_report.md" ] || sources+=("$dir/results/report/iteration${n}_report.md")
[ "$blind" = 0 ] || sources+=("$dir/DAG.md")
[ "$kind" = review ] || sources+=("$dir/REVIEW_RESPONSE.md")
if ! arh_secret_scan "$extra" "${sources[@]}"; then
  [ "$dry" = 1 ] || arh_die "the review request would carry what looks like a credential (above). Nothing was sent.
       Remove it from the file; if it is a false positive, set secret_scan = off in .arh/config/harnesses.md"
  arh_warn "the review request carries what looks like a credential (above); arh ask would refuse to send it"
fi
max_input=$(arh_config_get "$ARH_HARN" ask_max_input_bytes 48000)
ARH_ASK_MAX_PREDECLARATION=$(arh_config_get "$ARH_HARN" ask_max_predeclaration_bytes "")
export ARH_ASK_MAX_PREDECLARATION
max_rounds=$(arh_config_get "$ARH_HARN" ask_max_rounds 2)
if [ "$kind" = adjudication ]; then
  size=$(wc -c < "$prompt")
  [ -z "$ARH_ASK_MAX_PREDECLARATION" ] || size=$((size - $(wc -c < "$dir/README.md")))
  [ "$size" -le "$max_input" ] || arh_die "the adjudication request is $size bytes; ask_max_input_bytes is $max_input.
       Shorten the rebuttal, or raise ask_max_input_bytes and give the reason to --terms-changed"
  [ "$dry" = 0 ] || { printf '# dry run — would invoke: %s\n\n' "$primary"; cat "$prompt"; exit 0; }
elif [ "$dry" = 1 ]; then
  python3 "$ARH_HOME/lib/harness.py" budget "$dir" "$prompt" "$(arh_config_get "$ARH_HARN" "harness_${primary}_cmd" "")" \
    "$role" "$primary" "$pfam" "$(arh_config_get "$ARH_HARN" "harness_${primary}_family" unknown)" \
    "$max_input" "$max_rounds" "$extra" 1 >/dev/null
  printf '# dry run — would invoke: %s\n\n' "$primary"; cat "$prompt"; exit 0
fi

# The lock records its owner, so `arh wait` can tell a running review from one whose process died,
# and a lock left by a dead process on this host is reclaimed instead of refusing every later review.
lock="$dir/.review-lock"
if ! held=$(python3 "$ARH_HOME/lib/locks.py" acquire "$lock" "$$" "review lock" 2>&1); then
  lock=""; arh_die "another review is running${held#held}"
fi
[ -z "$held" ] || printf '%s\n' "$held" >&2

timeout_s=$(arh_config_get "$ARH_HARN" ask_timeout 900)
rc=0; tried=""
for h in $candidates; do
  if [ "$h" != "$primary" ]; then
    why=$(ineligible "$h")
    if [ -n "$why" ]; then arh_warn "fallback verifier '$h' skipped: ${why%%$'\n'*}"; continue; fi
    arh_warn "trying fallback verifier '$h'"
  fi
  vfam=$(arh_config_get "$ARH_HARN" "harness_${h}_family" unknown)
  cmd=$(arh_config_get "$ARH_HARN" "harness_${h}_cmd" "")
  cached=""
  [ "$kind" = adjudication ] \
    || cached=$(python3 "$ARH_HOME/lib/harness.py" budget "$dir" "$prompt" "$cmd" "$role" "$h" "$pfam" "$vfam" "$max_input" "$max_rounds" "$extra" 0)
  if [ -n "$cached" ]; then
    printf 'reused unchanged review (no model call): %s\n' "$cached"
    grep -m1 '^VERDICT:' "$cached"
    exit 0
  fi

  out=$(mktemp "$dir/${prefix}${h}_$(date -u +%Y%m%dT%H%M%SZ).XXXXXX")
  arh_share_mode "$out"
  mv "$out" "$out.md"
  out="$out.md"
  printf 'cross-check: role=%s harness=%s (%s) vs producer=%s (%s)\n' \
    "$role" "$h" "$vfam" "$producer" "$pfam" >&2
  {
    if [ "$kind" = adjudication ]; then
      printf '# Rebuttal adjudication — iteration %s\n\n' "$n"
      printf '| field | value |\n|---|---|\n'
      printf '| adjudicates | `%s` |\n| verifying harness | `%s` (%s) |\n' "${judged_review##*/}" "$h" "$vfam"
    else
    printf '# Cross-check — iteration %s\n\n' "$n"
    printf '| field | value |\n|---|---|\n'
    printf '| role | `%s` |\n| verifying harness | `%s` (%s) |\n' "$role" "$h" "$vfam"
    fi
    printf '| producing harness | `%s` (%s) |\n| same family | %s |\n' "$producer" "$pfam" \
           "$(if [ "$pfam" != "$vfam" ]; then echo no
              elif [ "$strict_family" = false ]; then echo 'yes — accepted, require_foreign_family = false'
              else echo 'yes — WEAKER CHECK'; fi)"
    printf '| foreign family required | %s |\n' "$strict_family"
    [ "$(arh_harness_config_state "$dir")" != changed ] \
      || printf '| review terms | changed since the claim: %s |\n' "${terms_reason//|/\\|}"
    printf '| run | %s |\n\n---\n\n' "$(arh_now)"
  } > "$out"

  # Parse quoted arguments without shell expansion; timeout is portable.
  # A harness can be slower than the rest: harness_<name>_timeout overrides ask_timeout for it.
  h_timeout=$(arh_config_get "$ARH_HARN" "harness_${h}_timeout" "$timeout_s")
  # ask_serialize = true: one call per verifier harness at a time across the project's sessions, so
  # two accounts' agents stop racing one provider quota (field feedback #51 serialised them by hand).
  serial=()
  if [ "$(arh_config_get "$ARH_HARN" ask_serialize false)" = true ]; then
    if command -v flock >/dev/null 2>&1; then
      mkdir -p "$ARH_STATE/locks"
      serial=(flock -E 75 -w "$(arh_config_get "$ARH_HARN" ask_serialize_wait 3600)" "$ARH_STATE/locks/ask-$h.lock")
      arh_info "waiting for any other review on '$h' in this project (ask_serialize = true)" >&2
    else arh_warn "ask_serialize = true, but flock is not installed; asks are not serialised"; fi
  fi
  set +e
  ${serial[@]+"${serial[@]}"} python3 "$ARH_HOME/lib/harness.py" run "$cmd" "$prompt" "$ARH_ROOT" "$out" "$h_timeout" "$pfam" "$vfam" "$same_family" \
    "$(arh_config_get "$ARH_HARN" ask_max_output_bytes 8000)" "$(arh_config_get "$ARH_HARN" "harness_${h}_version_cmd" "")" \
    "$strict_arg" "$terms_reason" "$judging"
  rc=$?
  set -e
  if [ "${#serial[@]}" -gt 0 ] && [ "$rc" = 75 ] && [ ! -f "$out.json" ]; then   # the wait for another session's review ran out: no call was made
    rm -f "$out" "$out.err"
    arh_warn "verifier '$h' is still busy with another session's review after ask_serialize_wait"
    tried="$tried $h"; continue
  fi
  cp "$prompt" "$out.prompt"
  [ -s "$out.err" ] || rm -f "$out.err"
  tried="$tried $h"
  case "$rc" in
    77) arh_warn "verifier '$h' refused to review this content (content policy); record kept at $out" ;;
    75) arh_warn "verifier '$h' is unavailable (usage or rate limit, authentication, or no answer in time); record kept at $out" ;;
    *) break ;;
  esac
done

if [ "$rc" -eq 75 ]; then
  arh_warn "no verifier was available (tried:$tried): usage or rate limit, authentication, or no answer in time.
       This did not consume a review round; record kept at $out
       Treat the reset the provider states (\"provider said\" above) as an upper bound, not a
       schedule: run the same arh ask again after a bounded wait instead of sleeping until then."
  exit "$rc"
fi
if [ "$rc" -eq 77 ]; then
  arh_warn "no verifier would review this content (tried:$tried): refused on content-policy grounds.
       This did not consume a review round. Waiting will not change it. Configure a harness from
       another model family as verifier_fallback in .arh/config/harnesses.md, or record the refusal
       as what blocks the iteration."
  exit "$rc"
fi
if [ "$rc" -ne 0 ]; then
  arh_warn "harness exited $rc — partial record kept at $out"
  exit "$rc"
fi

printf 'wrote %s\n' "$out"
if [ "$kind" = adjudication ]; then
  grep -m1 '^ADJUDICATION:' "$out"
  [ "$(printf '%s\n' "$pending" | grep -c .)" -le 1 ] || printf 'another rebutted UNSOUND review waits: arh ask --rebuttal -n %s\n' "$n"
else
  grep -m1 '^VERDICT:' "$out"
fi
