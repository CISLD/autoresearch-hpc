#!/usr/bin/env bash
# Who is working on an iteration, and taking it over on purpose.
#
#   arh lease show -n N                 holder, since when, and the last activity
#   arh lease take -n N --reason TEXT   become the holder; the previous one is kept in lease-history.jsonl
#
# Every arh command that acts on an iteration records itself in its lease, and warns when the
# iteration is held by another agent, user, host or ARH_SESSION. Set ARH_SESSION in a launcher to
# tell apart two sessions of one harness on one host.
set -euo pipefail
# shellcheck source=lib/common.sh
. "${ARH_HOME:?}/lib/common.sh"
case "${1-}" in -h|--help|"") sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac
sub="$1"; shift
n=""; reason=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--iteration) n="${2-}"; shift 2 ;;
    --reason) reason="${2-}"; shift 2 ;;
    *) arh_die "unexpected argument: $1" ;;
  esac
done
arh_load_project
[ -n "$n" ] || arh_die "which iteration? arh lease $sub -n N|VERIFICATION"
dir=$(arh_owner_dir "$n") || arh_die "no claimed iteration or verification '$n'"
[ -f "$dir/CLAIM.json" ] || [ -f "$dir/PREDECLARATION.md" ] || arh_die "no claimed iteration $n"
case "$sub" in
  show) exec python3 "$ARH_HOME/lib/lease.py" show "$dir" ;;
  take)
    [ -n "${reason//[[:space:]]/}" ] || arh_die "say why: arh lease take -n $n --reason 'the earlier session hit its usage limit'"
    arh_guard_path "$dir/metadata/lease.json"
    exec python3 "$ARH_HOME/lib/lease.py" take "$dir" "$reason" "$(arh_agent_name)" "${USER:-unknown}" "$(uname -n)" "${ARH_SESSION:-}" ;;
  *) arh_die "unknown: $sub (arh lease show | take)" ;;
esac
