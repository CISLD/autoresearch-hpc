#!/usr/bin/env bash
# Acceptance gates. The protocol's teeth.
set -euo pipefail
# shellcheck source=lib/common.sh
. "${ARH_HOME:?}/lib/common.sh"

sub="${1:-}"; shift || true
case "$sub" in -h|--help|"") echo 'usage: arh gate {predeclare|results|rules} [-n N | FILE]
arh gate results -n N --skeleton: print a REVIEW_RESPONSE.md listing every numbered review finding'; exit 0 ;; esac

n=""; file=""; skeleton=0
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--iteration) n="$2"; shift 2 ;;
    --skeleton) skeleton=1; shift ;;
    *) file="$1"; shift ;;
  esac
done
arh_load_project

fails=0
rule_ids() { arh_config_get "$ARH_PROJ" rules ""; }

# check_rules <file> <phase:predeclaration|report>
check_rules() {
  local doc="$1" phase="$2" r rf id sev applies forbid requires scope body bad
  body=$(tr 'A-Z' 'a-z' < "$doc")
  for r in $(rule_ids); do
    rf="$ARH_ROOT/rules/$r.md"
    [ -f "$rf" ] || { arh_fail "rule file missing: $rf"; fails=$((fails+1)); continue; }
    applies=$(arh_config_get "$rf" applies "report")
    case " $applies " in *" $phase "*) ;; *) continue ;; esac
    id=$(arh_config_get "$rf" id "$r")
    sev=$(arh_config_get "$rf" severity error)
    forbid=$(arh_config_get "$rf" forbid "")
    requires=$(arh_config_get "$rf" requires "")
    scope=$(arh_config_get "$rf" scope document)

    local hit_forbid=0 hit_req=0
    [ -n "$forbid" ]   && printf '%s' "$body" | grep -qEi -- "$forbid"   && hit_forbid=1
    [ -n "$requires" ] && printf '%s' "$body" | grep -qEi -- "$requires" && hit_req=1

    if [ -n "$forbid" ]; then
      # Forbidden language is allowed only alongside the required qualifier: anywhere in the
      # document by default, or in the same paragraph with `scope = paragraph`.
      if [ "$scope" = paragraph ] && [ -n "$requires" ]; then
        bad=$(printf '%s\n' "$body" | F=$(printf '%s' "$forbid" | tr 'A-Z' 'a-z') R=$(printf '%s' "$requires" | tr 'A-Z' 'a-z') \
              awk 'BEGIN { RS = ""; f = ENVIRON["F"]; r = ENVIRON["R"] } $0 ~ f && $0 !~ r { print substr($0, 1, 100); exit }')
        if [ -n "$bad" ]; then
          arh_fail "$id — a paragraph uses '$forbid' language without '$requires': ${bad%%$'\n'*}…"
          [ "$sev" = error ] && fails=$((fails+1)); continue
        fi
      elif [ "$hit_forbid" = 1 ] && [ "$hit_req" = 0 ]; then
        arh_fail "$id — uses '$forbid' language without stating '$requires'"
        [ "$sev" = error ] && fails=$((fails+1)); continue
      fi
    elif [ -n "$requires" ] && [ "$hit_req" = 0 ]; then
      arh_fail "$id — document never states: $requires"
      [ "$sev" = error ] && fails=$((fails+1)); continue
    fi
    arh_ok "$id"
  done
}

case "$sub" in
  predeclare)
    [ -n "$n" ] || arh_die "arh gate predeclare -n N"
    dir="$ARH_ITERS/iteration$n"
    readme="$dir/README.md"
    [ -f "$readme" ] || arh_die "no pre-declaration at $readme (run: arh new -n $n)"
    arh_guard_path "$dir/PREDECLARATION.sha256"
    [ ! -e "$dir/PREDECLARATION.sha256" ] || arh_die "already frozen; corrections require a new iteration"
    # The freeze journal outlives the freeze file: deleting PREDECLARATION.sha256 does not make a plan
    # freezable again (external review of v0.3.0, probe 3).
    if journalled=$(python3 "$ARH_HOME/lib/record.py" frozen "$ARH_ROOT" "$n"); then
      arh_die "iteration $n was frozen at $(printf '%s' "$journalled" | cut -f3) (.arh/freezes.tsv); its freeze file is gone, but a plan is frozen once. Corrections require a new iteration"
    fi
    printf 'gate: pre-declaration, iteration %s\n' "$n"
    arh_lease_touch "$dir" "arh gate predeclare"

    # Results must not exist yet. A pre-declaration written after the answer is
    # not a pre-declaration.
    if [ -n "$(find "$dir/results" \( -type f -o -type l \) 2>/dev/null | head -1)" ]; then
      arh_fail "results/ is already populated — this cannot be pre-declared"
      fails=$((fails+1))
    else
      arh_ok "results/ is empty"
    fi
    # Nor a run or a review: either means the analysis already happened.
    ran=$(find "$dir/logs" -path '*/attempt-*/run.json' 2>/dev/null | grep -c . || true)
    reviewed=$(find "$dir" -maxdepth 1 -name 'CROSSCHECK_*.md' 2>/dev/null | grep -c . || true)
    if [ "$ran" -gt 0 ] || [ "$reviewed" -gt 0 ]; then
      arh_fail "this iteration already has $ran run receipt(s) and $reviewed review(s) — it cannot be pre-declared now"
      fails=$((fails+1))
    fi

    # required_sections is a comma-separated list of headings; each must appear as a heading in the
    # README with something under it. Seven headings over empty bodies froze in v0.3.0.
    python3 "$ARH_HOME/lib/record.py" sections "$readme" "$ARH_HOME/templates/iteration/README.md" \
      "$(arh_config_get "$ARH_PROJ" required_sections "")" || fails=$((fails+$?))

    # Placeholders left in the template are an incomplete pre-declaration.
    # Template placeholders open at column 0 and may wrap over several lines,
    # so anchor on the opening bracket rather than trying to match the pair.
    if grep -qE '^<[[:alpha:]]|\{\{[A-Z_]+\}\}|\bTODO\b|\bTBD\b' "$readme"; then
      arh_fail "template placeholders remain unfilled"; fails=$((fails+1))
    else
      arh_ok "no placeholders remain"
    fi

    check_rules "$readme" predeclaration

    # Code imported from other iterations is frozen with the plan that relies on it.
    if imports=$(python3 "$ARH_HOME/lib/imports.py" freeze "$ARH_ROOT" "$readme" 2>&1); then
      [ -z "$imports" ] || arh_ok "imports: $(printf '%s\n' "$imports" | grep -c .) file(s) hashed with the plan"
    else
      while IFS= read -r line; do arh_fail "$line"; done <<< "$imports"; fails=$((fails+1)); imports=""
    fi

    # Commands the plan declares in an arh-smoke block are run once in their image before the freeze:
    # a flag copied from a patched build's VCF header failed only on the first real task (2026-10-04).
    # One command per line, optionally prefixed by the image key: `vg: vg --version`.
    smoke_cmds=$(awk '/^[ \t]*```[ \t]*arh-smoke[ \t]*$/ {inb=1; next} /^[ \t]*```/ {inb=0} inb' "$readme")
    smoke_line=""
    if [ -n "${smoke_cmds//[[:space:]]/}" ] && [ "$fails" = 0 ]; then
      smoke_out="$dir/metadata/predeclare-smoke.txt"; mkdir -p "$dir/metadata"; : > "$smoke_out"
      while IFS= read -r line; do
        case "$line" in ''|\#*) continue ;; esac
        image=runtime; command=$line
        if printf '%s' "$line" | grep -qE '^[A-Za-z0-9_-]+:[[:space:]]'; then image=${line%%:*}; command=${line#*:}; fi
        printf '$ [%s] %s\n' "$image" "$command" >> "$smoke_out"
        if "$ARH_HOME/bin/arh" run "$image" -- /bin/sh -c "$command" >> "$smoke_out" 2>&1; then
          arh_ok "smoke [$image]:$command"
        else
          arh_fail "smoke [$image]:$command failed (output in ${smoke_out#"$ARH_ROOT"/})"; fails=$((fails+1))
        fi
      done <<< "$smoke_cmds"
      smoke_line="smoke $(arh_sha256 "$smoke_out") ${smoke_out#"$ARH_ROOT"/}"
    fi

    if [ "$fails" -gt 0 ]; then
      printf '\ngate FAILED (%s). Nothing was frozen; fix and re-run.\n' "$fails" >&2; exit 1
    fi
    at=$(arh_now); anchor=""
    # The scaffold says DRAFT; the line said PRE-DECLARED from `arh new` on, so a half-written plan read
    # as declared and carried the claim date, not the freeze date (field feedback #80). Stamp it now,
    # before hashing, so the frozen copy carries the date it was frozen.
    sed -i "s|^\*\*Status: DRAFT (claimed [^)]*); arh gate predeclare stamps the freeze date here\.\*\*\$|**Status: PRE-DECLARED ${at%%T*} (frozen by arh gate predeclare). Written BEFORE any result exists.**|" "$readme"
    sha=$(arh_sha256 "$readme")
    # freeze_anchor (project.md) records the freeze somewhere the project cannot rewrite: a pushed git
    # commit, a timestamping service, a scheduler job comment. Its first output line goes into the
    # journal. If it fails, nothing is frozen.
    anchor_cmd=$(arh_config_get "$ARH_PROJ" freeze_anchor "")
    if [ -n "$anchor_cmd" ]; then
      anchor_cmd=${anchor_cmd//\{iteration\}/$n}; anchor_cmd=${anchor_cmd//\{sha256\}/$sha}
      anchor_out=$(cd "$ARH_ROOT" && bash -c "$anchor_cmd" 2>&1) \
        || arh_die "freeze_anchor failed, so nothing was frozen: $(printf '%s' "$anchor_out" | tail -1)"
      anchor=$(printf '%s\n' "$anchor_out" | head -1)
    fi
    scripts_pinned=$(python3 "$ARH_HOME/lib/imports.py" scripts "$ARH_ROOT" "$dir")
    ( set -C; { printf '%s\n%s\n' "$sha" "$at"; [ -z "$imports" ] || printf '%s\n' "$imports"
                [ -z "$scripts_pinned" ] || printf '%s\n' "$scripts_pinned"
                [ -z "$smoke_line" ] || printf '%s\n' "$smoke_line"; } > "$dir/PREDECLARATION.sha256" ) \
      || arh_die "freeze already exists"
    python3 "$ARH_HOME/lib/record.py" append "$ARH_ROOT" "$n" "$sha" "$at" "$anchor" >/dev/null \
      || arh_die "the freeze of iteration $n could not be journalled in .arh/freezes.tsv"
    printf '\ngate PASSED. Pre-declaration frozen:\n  %s\n' "$(head -1 "$dir/PREDECLARATION.sha256")"
    [ -z "$scripts_pinned" ] || printf '  and %s script(s) already in scripts/, pinned with it\n' "$(printf '%s\n' "$scripts_pinned" | grep -c .)"
    printf 'The README hash is frozen and journalled; later edits will fail validation. Corrections go in a new iteration.\n'
    [ -z "$anchor" ] || printf 'Anchored: %s\n' "$anchor"
    ;;

  results)
    [ -n "$n" ] || arh_die "arh gate results -n N"
    dir="$ARH_ITERS/iteration$n"
    # A starting point for REVIEW_RESPONSE.md: every numbered finding of every eligible review.
    if [ "$skeleton" = 1 ]; then exec python3 "$ARH_HOME/lib/findings.py" skeleton "$dir"; fi
    readme="$dir/README.md"
    frozen="$dir/PREDECLARATION.sha256"
    printf 'gate: results, iteration %s\n' "$n"
    arh_lease_touch "$dir" "arh gate results"

    if [ ! -f "$frozen" ]; then
      arh_fail "no frozen pre-declaration — results were produced outside the protocol"
      fails=$((fails+1))
    else
      want=$(head -1 "$frozen"); got=$(arh_sha256 "$readme")
      if [ "$want" = "$got" ]; then
        arh_ok "pre-declaration unchanged since freeze"
      else
        arh_fail "README.md CHANGED after pre-declaration was frozen"
        arh_info "frozen: $want"
        arh_info "now:    $got"
        fails=$((fails+1))
      fi
      # The freeze must be the one the journal recorded when the plan was first frozen.
      if journalled=$(python3 "$ARH_HOME/lib/record.py" frozen "$ARH_ROOT" "$n"); then
        if [ "$(printf '%s' "$journalled" | cut -f2)" = "$want" ]; then
          arh_ok "freeze matches the journal ($(printf '%s' "$journalled" | cut -f3))"
        else
          arh_fail "PREDECLARATION.sha256 differs from the freeze journalled at $(printf '%s' "$journalled" | cut -f3): the plan was frozen again"
          fails=$((fails+1))
        fi
      elif [ -f "$ARH_STATE/freezes.tsv" ] || python3 "$ARH_HOME/lib/record.py" era "$dir"; then
        arh_fail "iteration $n is not in the freeze journal: its freeze was not made by arh gate predeclare"
        fails=$((fails+1))
      else
        printf '  WARN no freeze journal (.arh/freezes.tsv); run arh migrate --apply to start one\n'
      fi
    fi

    # A confirmation's frozen decisions must still be the ones it applied.
    if [ -f "$dir/FREEZE.json" ]; then
      if out=$(python3 "$ARH_HOME/lib/freeze.py" check "$ARH_ROOT" "$dir" 2>&1); then arh_ok "freeze: $out"
      else arh_fail "freeze: $out"; fails=$((fails+1)); fi
    fi
    if [ -f "$ARH_STATE/unseals.tsv" ]; then
      awk -F'\t' -v n="$n" 'NR>1 && $2==n {print "  read sealed input " $5 " in run " $3 " (" $1 ")"}' "$ARH_STATE/unseals.tsv"
    fi

    # Work that ran outside arh submit has no receipt; say so instead of letting the record imply one.
    python3 "$ARH_HOME/lib/record.py" runs "$dir"
    pinned=$(python3 "$ARH_HOME/lib/imports.py" changed "$ARH_ROOT" "$dir")
    if [ -n "$pinned" ]; then
      printf '  WARN %s script(s) pinned with the frozen plan changed since the freeze; name each in the report as a deviation: %s\n' \
        "$(printf '%s\n' "$pinned" | grep -c .)" "$(printf '%s\n' "$pinned" | paste -sd' ' -)"
    fi
    receipts=$(find "$dir/logs" -path '*/attempt-*/run.json' 2>/dev/null | grep -c . || true)
    if [ -n "$(find "$dir/results" -type f ! -path '*/report/*' 2>/dev/null | head -1)" ] && [ "$receipts" = 0 ]; then
      printf '  WARN results exist but no arh submit run receipt does: what produced them is not on record\n'
    fi
    if [ -s "$dir/metadata/notes.jsonl" ]; then
      printf '  WARN %s note(s) of work outside arh submit, without run receipts (arh note list -n %s)\n' \
        "$(grep -c . "$dir/metadata/notes.jsonl")" "$n"
    fi
    while IFS=$'\t' read -r vname _ vstate voutcome; do
      [ -n "$vname" ] && printf '  verification %s: %s (%s)\n' "$vname" "$voutcome" "$vstate"
    done < <(python3 "$ARH_HOME/lib/verification.py" rows "$ARH_ROOT" "$ARH_VERIFY" "$n")

    report="$dir/results/report/iteration${n}_report.md"
    if [ -f "$report" ]; then
      arh_ok "report present"; check_rules "$report" report
      # Numbers the report states that no results file holds: transcription errors, or values
      # computed in the prose that belong in a results file (report_numbers = warn | require | off).
      numbers=$(arh_config_get "$ARH_PROJ" report_numbers warn)
      if [ "$numbers" != off ]; then
        unmatched=$(python3 "$ARH_HOME/lib/report_numbers.py" check "$dir" "$report" "$(arh_config_get "$ARH_PROJ" report_numbers_files "")")
        if [ -n "$unmatched" ]; then
          count=$(printf '%s\n' "$unmatched" | grep -c .)
          if [ "$numbers" = require ]; then arh_fail "$count number(s) in the report match no file under results/"; fails=$((fails+1))
          else printf '  WARN %s number(s) in the report match no file under results/ (check them, or write them to one):\n' "$count"; fi
          printf '%s\n' "$unmatched" | head -12 | awk -F'\t' '{ printf "       line %s: %s   %s\n", $1, $2, $3 }'
          [ "$count" -le 12 ] || printf '       … and %s more\n' "$((count - 12))"
        fi
      fi
    else arh_fail "no report at ${report#"$ARH_ROOT"/}"; fails=$((fails+1)); fi

    if [ "$(arh_review_policy "$dir" require_crosscheck true)" = true ]; then
      if arh_crosschecks "$dir" | grep -q .; then
        # Not "foreign": a project may accept same-family review, and describe says which ones were.
        arh_ok "eligible review(s); a verdict is evidence, not endorsement"
        python3 "$ARH_HOME/lib/harness.py" describe "$dir"
        # Protocol 6.5: every numbered finding is answered in REVIEW_RESPONSE.md (review_response).
        python3 "$ARH_HOME/lib/findings.py" check "$dir" "$(arh_review_policy "$dir" review_response require)" \
          || fails=$((fails+1))
        # An UNSOUND verdict concludes only with a rebuttal a reviewer accepted (unsound_review).
        python3 "$ARH_HOME/lib/findings.py" verdicts "$dir" "$(arh_review_policy "$dir" unsound_review require-adjudication)" \
          || fails=$((fails+1))
      else
        arh_fail "no eligible cross-check; inspect execution metadata and artifact hashes"
        python3 "$ARH_HOME/lib/harness.py" describe "$dir"
        fails=$((fails+1))
      fi
    fi

    [ "$fails" -gt 0 ] && { printf '\ngate FAILED (%s).\n' "$fails" >&2; exit 1; }
    # The conclusion receipt: the hashes this pass rested on, so the ledger can say which iterations
    # concluded and how many attempts at their question came first.
    python3 "$ARH_HOME/lib/attempts.py" conclude "$dir"
    printf '\ngate PASSED. Iteration %s is concluded (metadata/conclusions.jsonl); record it with arh ledger render.\n' "$n"
    ;;

  rules)
    [ -n "$file" ] || arh_die "arh gate rules FILE"
    [ -f "$file" ] || arh_die "no such file: $file"
    printf 'gate: standing rules, %s\n' "$file"
    check_rules "$file" report
    [ "$fails" -gt 0 ] && { printf '\n%s rule violation(s).\n' "$fails" >&2; exit 1; }
    printf '\nAll standing rules satisfied.\n'
    ;;
  *) arh_die "unknown gate: $sub" ;;
esac
