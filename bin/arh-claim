#!/usr/bin/env bash
# Atomically claim the next iteration number.
set -euo pipefail
# shellcheck source=lib/common.sh
. "${ARH_HOME:?}/lib/common.sh"

title=""; agent=""
while [ $# -gt 0 ]; do
  case "$1" in
    -t|--title) title="$2"; shift 2 ;;
    -a|--agent) agent="$2"; shift 2 ;;
    -h|--help)  echo 'usage: arh claim -t TITLE [-a AGENT]'; exit 0 ;;
    *) arh_die "unexpected argument: $1" ;;
  esac
done
[ -n "$title" ] || arh_die "a title is required: arh claim -t 'the question'"

arh_load_project
# Who claimed this iteration. The configured producer is operator-owned and carries the
# model and account a lane pinned into its name; ARH_AGENT and the harness markers are set
# by the session itself and lose that. So the configured producer wins over both, `-a`
# wins over everything, and what the session reported is recorded alongside either way.
inferred=$(arh_agent_name); inferred_from=$(arh_agent_source)
producer=$(arh_config_get "$ARH_HARN" producer "")
if [ -n "$agent" ]; then
  agent_source='claim --agent'
elif [ -n "$producer" ] && [ "$producer" != "$inferred" ] && [ "$inferred_from" != USER ]; then
  arh_warn_agent_mismatch
  arh_warn "recording '$producer' as this iteration's agent; '$inferred' is kept as inferred_agent"
  agent=$producer; agent_source='config:producer'
else
  agent=$inferred; agent_source=$inferred_from
fi
mkdir -p "$ARH_ITERS"

n=$(
  { find "$ARH_ITERS" -maxdepth 1 -type d -name 'iteration*' 2>/dev/null \
      | sed -n 's|.*/iteration\([0-9]\{1,\}\)$|\1|p'
    awk -F'\t' 'NR>1 && $1 ~ /^[0-9]+$/ {print $1}' "$ARH_REGISTRY" 2>/dev/null
  } | sort -n | tail -1
)
n=$(( ${n:-0} + 1 ))

dir=""
for _ in $(seq 1 100); do
  if mkdir "$ARH_ITERS/iteration$n" 2>/dev/null; then dir="$ARH_ITERS/iteration$n"; break; fi
  n=$((n + 1))
done
[ -n "$dir" ] || arh_die "could not claim an iteration number after 100 attempts"

# The review terms the iteration is claimed under. A copy, so that a later change can be shown and
# not only detected; its hash in CLAIM.json is what arh ask and arh gate results compare against.
terms=""
if [ -f "$ARH_HARN" ]; then
  mkdir -p "$dir/metadata"
  cp "$ARH_HARN" "$dir/metadata/harnesses.claimed.md"
  terms=$(arh_sha256 "$dir/metadata/harnesses.claimed.md")
fi

# What the claim was made knowing: the hashes of DIRECTIVES.md, GOTCHAS.md and the site's shared gotchas,
# so a later session can see whether the directives changed under the iteration.
knowledge=$(python3 "$ARH_HOME/lib/project.py" knowledge-hashes "$ARH_ROOT")

cat > "$dir/CLAIM.json" <<EOF
{
  "iteration": $n,
  "agent": "$agent",
  "agent_source": "$agent_source",
  "declared_agent": "$agent",
  "inferred_agent": "$inferred",
  "inferred_from": "$inferred_from",
  "claimed": "$(arh_now)",
  "title": $(printf '%s' "$title" | sed 's/\\/\\\\/g; s/"/\\"/g; s/^/"/; s/$/"/'),
  "status": "CLAIMED",
  "session": "${ARH_SESSION:-}",
  "harness_config_sha256": "$terms",
  "knowledge_sha256": $knowledge,
  "freeze_journal": true
}
EOF

_append_row() { printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$agent" "$(arh_now)" CLAIMED "$title" >> "$ARH_REGISTRY"; }
if command -v flock >/dev/null 2>&1; then
  exec 9>>"$ARH_REGISTRY.lock"; flock 9; _append_row; exec 9>&-
else
  until mkdir "$ARH_REGISTRY.lock.d" 2>/dev/null; do sleep 0.2; done
  _append_row; rmdir "$ARH_REGISTRY.lock.d"
fi

mkdir -p "$dir"/{scripts,results,logs,resources,metadata}
arh_lease_touch "$dir" "arh claim"
printf '%s\n' "$n"
printf 'claimed iteration %s at %s\n' "$n" "$dir" >&2
printf 'next: arh new -n %s   (complete the pre-declaration BEFORE running anything)\n' "$n" >&2
printf 'read: DIRECTIVES.md and GOTCHAS.md; write what this session learns there, not to private memory\n' >&2
