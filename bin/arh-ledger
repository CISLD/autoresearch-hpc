#!/usr/bin/env bash
# Maintain the project record.
#
#   arh ledger check   — is the ledger consistent with what is on disk?
#   arh ledger render  — regenerate the status table from the iteration record
set -euo pipefail
# shellcheck source=lib/common.sh
. "${ARH_HOME:?}/lib/common.sh"
sub="${1:-check}"
case "$sub" in -h|--help) echo 'usage: arh ledger {check|render}'; exit 0 ;; esac
arh_load_project
[ -f "$ARH_LEDGER" ] || arh_die "no ledger at $ARH_LEDGER"

iters=$(find "$ARH_ITERS" -maxdepth 1 -type d -name 'iteration*' 2>/dev/null \
        | sed -n 's|.*/iteration\([0-9]\{1,\}\)$|\1|p' | sort -n)

build_table() {
  printf '<!-- arh:status:begin — generated by `arh ledger render`; do not edit by hand -->\n\n'
  printf '| It. | Claimed by | Pre-declaration | Results | Cross-check | Subject |\n'
  printf '|---|---|---|---|---|---|\n'
  for d in $iters; do
    dir="$ARH_ITERS/iteration$d"
    # `|| true`: under pipefail a missing CLAIM.json made sed fail and killed render silently.
    agent=$(sed -n 's/.*"declared_agent"[ ]*:[ ]*"\([^"]*\)".*/\1/p' "$dir/CLAIM.json" 2>/dev/null | head -1 || true)
    title=$(sed -n 's/.*"title"[ ]*:[ ]*"\(.*\)",\{0,1\}$/\1/p' "$dir/CLAIM.json" 2>/dev/null | head -1 || true)
    if [ -f "$dir/PREDECLARATION.sha256" ]; then
      [ "$(head -1 "$dir/PREDECLARATION.sha256")" = "$(arh_sha256 "$dir/README.md" 2>/dev/null)" ] \
        && pre='frozen' || pre='**ALTERED**'
    elif [ -f "$dir/README.md" ]; then pre=draft; else pre='—'; fi
    [ -f "$dir/results/report/iteration${d}_report.md" ] && res=report || res='—'
    # The verdicts themselves, not "yes": an UNSOUND review is part of the record (external review, 2026-10-13).
    xc=$(python3 "$ARH_HOME/lib/findings.py" summary "$dir"); [ -n "$xc" ] || xc='—'
    printf '| %s | %s | %s | %s | %s | %s |\n' "$d" "${agent:-—}" "$pre" "$res" "$xc" "${title:-—}"
  done
  # Verifications sit beside the iterations they check (arh verify conclude records the outcome).
  vrows=$(python3 "$ARH_HOME/lib/verification.py" rows "$ARH_ROOT" "$ARH_VERIFY")
  if [ -n "$vrows" ]; then
    printf '\n| Verification | Of iteration | Pre-declaration | Outcome |\n|---|---|---|---|\n'
    printf '%s\n' "$vrows" | awk -F'\t' '{ printf "| %s | %s | %s | %s |\n", $1, $2, ($3 == "ALTERED" ? "**ALTERED**" : $3), $4 }'
  fi
  printf '\n<!-- arh:status:end -->\n'
}

# A status block under another marker (a 0.1 ledger's, say) is not ours to replace, and appending
# a second table beside it leaves the ledger contradicting itself.
foreign_marker() {
  grep -oE '<!-- *[A-Za-z0-9_.-]+:status:begin' "$ARH_LEDGER" \
    | sed 's/^<!-- *//; s/:status:begin$//' | grep -vx arh | head -1 || true
}

case "$sub" in
  render)
    other=$(foreign_marker)
    [ -z "$other" ] || arh_die "the ledger has a status block marked '$other:status', not 'arh:status'.
       Rendering would add a second table. Rename its begin/end markers (arh migrate does this for 0.1 studies)."
    tmp=$(mktemp); table=$(mktemp); build_table > "$table"
    if grep -q 'arh:status:begin' "$ARH_LEDGER"; then
      awk -v f="$table" '
        /arh:status:begin/ { while ((getline l < f) > 0) print l; skip=1; next }
        /arh:status:end/   { skip=0; next }
        !skip { print }' "$ARH_LEDGER" > "$tmp"
    else
      { cat "$ARH_LEDGER"; printf '\n'; cat "$table"; } > "$tmp"
    fi
    mv "$tmp" "$ARH_LEDGER"; rm -f "$table"
    printf 'rendered status table into %s\n' "${ARH_LEDGER#"$ARH_ROOT"/}"
    ;;
  check)
    fails=0
    for d in $iters; do
      dir="$ARH_ITERS/iteration$d"
      if [ -f "$dir/PREDECLARATION.sha256" ] && [ -f "$dir/README.md" ]; then
        if [ "$(head -1 "$dir/PREDECLARATION.sha256")" != "$(arh_sha256 "$dir/README.md")" ]; then
          arh_fail "iteration $d — README.md altered after its pre-declaration was frozen"
          fails=$((fails+1)); continue
        fi
      fi
      if [ -f "$dir/results/report/iteration${d}_report.md" ] && [ ! -f "$dir/PREDECLARATION.sha256" ]; then
        arh_fail "iteration $d — has a report but was never pre-declared"; fails=$((fails+1)); continue
      fi
      if [ -f "$dir/results/report/iteration${d}_report.md" ] && [ "$(arh_config_get "$ARH_PROJ" require_crosscheck true)" = true ] && [ -z "$(arh_crosschecks "$dir")" ]; then
        arh_fail "iteration $d — no valid cross-check"; fails=$((fails+1))
      fi
      grep -q "iteration $d\b\|iteration${d}\b\|^| $d |" "$ARH_LEDGER" 2>/dev/null \
        && arh_ok "iteration $d" || { arh_fail "iteration $d — absent from the ledger"; fails=$((fails+1)); }
    done
    # The record's own integrity: every claimed number still has its directory (a deleted concluded
    # iteration once left this check passing), and the freeze journal chains and agrees with the disk.
    for d in $(python3 "$ARH_HOME/lib/record.py" registry "$ARH_ROOT" "$ARH_ITERS"); do
      arh_fail "iteration $d — in the claim registry, but its directory is gone"; fails=$((fails+1))
    done
    if problems=$(python3 "$ARH_HOME/lib/record.py" verify "$ARH_ROOT" "$ARH_ITERS"); then
      [ -z "$iters" ] || arh_ok "freeze journal chains and matches every frozen iteration"
    else
      while IFS= read -r line; do [ -z "$line" ] || { arh_fail "$line"; fails=$((fails+1)); }; done <<< "$problems"
    fi
    # The generated section must equal a fresh render (protocol 8.3): a stale, missing or
    # duplicated table is an inconsistency even when every iteration number appears somewhere.
    other=$(foreign_marker)
    if [ -n "$other" ]; then
      arh_fail "status block marked '$other:status' — rename its markers to arh:status, then arh ledger render"
      fails=$((fails+1))
    elif [ -n "$iters" ]; then
      if [ "$(awk '/arh:status:begin/{p=1} p{print} /arh:status:end/{p=0}' "$ARH_LEDGER")" = "$(build_table)" ]; then
        arh_ok "status table matches a fresh render"
      else
        arh_fail "status table is stale or missing — run: arh ledger render"; fails=$((fails+1))
      fi
    fi
    [ "$fails" -gt 0 ] && { printf '\n%s ledger problem(s).\n' "$fails" >&2; exit 1; }
    printf '\nLedger consistent with %s iteration(s) on disk.\n' "$(printf '%s\n' $iters | grep -c . || true)"
    ;;
  *) arh_die "unknown: $sub" ;;
esac
